        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore היה עסוק בבקשה אחרת, ולכן לא התחיל להסיר מקור זה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 正忙于其他请求，因此未开始移除此源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 正忙於其他請求，因此未開始移除此來源。"
          }
        }
      }
    },
    "SideStore's active signing certificate has expired. Open Certificates and select or create a current certificate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore's active signing certificate has expired. Open Certificates and select or create a current certificate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף תעודת החתימה הפעילה של SideStore פג. יש לפתוח את 'תעודות חתימה' ולבחור או ליצור תעודה תקפה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 当前的签名证书已过期。请打开“证书”，选择或创建有效证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 目前的簽署憑證已過期。請開啟「憑證」，選取或建立有效憑證。"
          }
        }
      }
    },
