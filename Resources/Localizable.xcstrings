    "Only clear this request after checking the account, source, certificate, pairing, or setting it may have changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only clear this request after checking the account, source, certificate, pairing, or setting it may have changed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לנקות בקשה זו רק לאחר בדיקת החשבון, המקור, תעודת החתימה, הצימוד או ההגדרה שייתכן שהשתנו בעקבותיה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先检查此请求可能已更改的账户、源、证书、配对或设置，然后才能清除此请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先檢查此請求可能已更改的帳號、來源、憑證、配對或設定，然後才能清除此請求。"
          }
        }
      }
    },
    "Only continue after confirming SideStore is no longer refreshing apps on the device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only continue after confirming SideStore is no longer refreshing apps on the device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להמשיך רק לאחר אימות ש-SideStore אינו מרענן עוד יישומים במכשיר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认 SideStore 已不再刷新设备上的应用，然后才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認 SideStore 已不再重新整理裝置上的應用程式，然後才能繼續。"
          }
        }
      }
    },
    "Only continue after confirming the device is no longer installing, updating, refreshing, backing up, restoring, or deleting the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only continue after confirming the device is no longer installing, updating, refreshing, backing up, restoring, or deleting the app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להמשיך רק לאחר אימות שהמכשיר אינו מתקין, מעדכן, מרענן, מגבה, משחזר או מוחק עוד את היישום."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认设备已不再安装、更新、刷新、备份、恢复或删除此应用，然后才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認裝置已不再安裝、更新、重新整理、備份、恢復或刪除此應用程式，然後才能繼續。"
          }
        }
      }
    },
    "Only continue after confirming the device is no longer installing, updating, refreshing, or deleting an app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only continue after confirming the device is no longer installing, updating, refreshing, or deleting an app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להמשיך רק לאחר אימות שהמכשיר אינו מתקין, מעדכן, מרענן או מוחק עוד יישום."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认设备已不再安装、更新、刷新或删除应用，然后才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認裝置已不再安裝、更新、重新整理或刪除應用程式，然後才能繼續。"
          }
        }
      }
    },
