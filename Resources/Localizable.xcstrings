    "Use the same Apple ID as the saved account. Reload status if the account changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same Apple ID as the saved account. Reload status if the account changed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש באותו Apple ID של החשבון השמור. אם החשבון השתנה, יש לטעון מחדש את המצב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用与已保存账户相同的 Apple ID。如果账户已更改，请重新加载状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用與已儲存帳號相同的 Apple ID。如果帳號已更改，請重新載入狀態。"
          }
        }
      }
    },
    "Use this only after confirming the device is no longer installing, updating, refreshing, backing up, restoring, or deleting the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this only after confirming the device is no longer installing, updating, refreshing, backing up, restoring, or deleting the app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש באפשרות זו רק לאחר אימות שהמכשיר אינו מתקין, מעדכן, מרענן, מגבה, משחזר או מוחק עוד את היישום."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在确认设备已不再安装、更新、刷新、备份、恢复或删除此应用后，才能使用此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在確認裝置已不再安裝、更新、重新整理、備份、恢復或刪除此應用程式後，才能使用此操作。"
          }
        }
      }
    },
    "Use this only if the placement tool did not work. Pick a .mobiledevicepairing or .plist file. This screen owns the picker; the service only validates and stores the file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this only if the placement tool did not work. Pick a .mobiledevicepairing or .plist file. This screen owns the picker; the service only validates and stores the file."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש באפשרות זו רק אם הכלי להצבת הקובץ לא פעל. יש לבחור קובץ ‎.mobiledevicepairing או ‎.plist. בורר הקבצים שייך למסך זה; השירות רק מאמת ומאחסן את הקובץ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在放置工具无法正常工作时使用此方式。请选择 .mobiledevicepairing 或 .plist 文件。选择器由此界面提供；服务仅验证和保存文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在放置工具無法正常工作時使用此方式。請選取 .mobiledevicepairing 或 .plist 檔案。選取器由此介面提供；服務僅驗證和儲存檔案。"
          }
        }
      }
    },
