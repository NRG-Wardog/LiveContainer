    "lc.settings.injectLCItselfDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع تعديلاتك على مِلَفّ التعديلات العالمي و LiveContainer سوف يأخذهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Ihre Tweaks in den globalen Tweak-Ordner und LiveContainer wird sie aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your tweaks into the global “Tweaks” folder and LiveContainer will pick them up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos tweaks dans le dossier global \"Tweaks\" et LiveContainer les récupérera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、LiveContainer は自動的にグローバルモジュールフォルダー内のモジュールをロードします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seus ajustes na pasta global com nome de \"Ajustes\" e o LiveContainer irá identificá-los."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera din tweaks i den globala “Tweaks” mappen och LiveContainer kommer att plocka upp dem."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ các tweak vào thư mục công cộng “Tweaks” và LiveContainer sẽ dùng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，LiveContainer自身会加载全局模块文件夹中的模块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將補丁放入全域的「Tweaks」資料夾，LiveContainer 就會載入它們。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לשים את התוספים בתיקייה הכללית “Tweaks”, ו-LiveContainer יטען אותם."
          }
        }
      }
    },
