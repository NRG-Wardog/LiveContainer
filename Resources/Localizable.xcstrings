    "Keep changes paused and allow the active SideStore process to finish. Copy Diagnostics if the lock stays unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep changes paused and allow the active SideStore process to finish. Copy Diagnostics if the lock stays unavailable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את השינויים מושהים ולאפשר לתהליך SideStore הפעיל להסתיים. אם הנעילה נותרת לא זמינה, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持更改暂停，让正在运行的 SideStore 进程完成。如果锁仍不可用，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持更改暫停，讓正在執行的 SideStore 程序完成。如果鎖仍不可用，請複製診斷資訊。"
          }
        }
      }
    },
    "Keep changes paused and copy Diagnostics. The record was not confirmed removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep changes paused and copy Diagnostics. The record was not confirmed removed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את השינויים מושהים ולהעתיק את פרטי האבחון. הסרת הרשומה לא אושרה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持更改暂停并复制诊断信息。尚未确认记录已移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持更改暫停並複製診斷資訊。尚未確認記錄已移除。"
          }
        }
      }
    },
    "Keep changes paused. Check device storage access and copy Diagnostics; do not clear an unclassified record.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep changes paused. Check device storage access and copy Diagnostics; do not clear an unclassified record."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את השינויים מושהים. יש לבדוק את הגישה לאחסון המכשיר ולהעתיק את פרטי האבחון; אין למחוק רשומה שלא סווגה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持更改暂停。检查设备存储访问权限并复制诊断信息；不要清除尚未分类的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持更改暫停。檢查裝置儲存存取權限並複製診斷資訊；不要清除尚未分類的記錄。"
          }
        }
      }
    },
    "Keep changes paused. Check that the combined app can access its shared App Group; copy Diagnostics for support. Clearing a record cannot repair unavailable storage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep changes paused. Check that the combined app can access its shared App Group; copy Diagnostics for support. Clearing a record cannot repair unavailable storage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את השינויים מושהים. יש לוודא שהיישום המשולב יכול לגשת לקבוצת היישומים המשותפת שלו ולהעתיק את פרטי האבחון לתמיכה. מחיקת רשומה לא תתקן אחסון שאינו זמין."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持更改暂停。检查合并应用能否访问其共享 App 群组，并复制诊断信息以寻求支持。清除记录无法修复存储不可用的问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持更改暫停。檢查合併應用程式能否存取其共享 App 群組，並複製診斷資訊以尋求支援。清除記錄無法修復儲存不可用的問題。"
          }
        }
      }
    },
    "Keep recovery hold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep recovery hold"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השארת חסימת השחזור"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持恢复暂停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持恢復暫停"
          }
        }
      }
    },
    "Keep the existing Anisette and account data unchanged. Copy Diagnostics for review before another sign-in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the existing Anisette and account data unchanged. Copy Diagnostics for review before another sign-in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את נתוני Anisette והחשבון הקיימים ללא שינוי. יש להעתיק את פרטי האבחון לבדיקה לפני ניסיון כניסה נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持现有的 Anisette 和账户数据不变。在再次登录前，请复制诊断信息以供检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持現有的 Anisette 和帳號資料不變。在再次登入前，請複製診斷資訊以供檢查。"
          }
        }
      }
    },
    "Keep this screen open while SideStore finishes cleanup. If it remains here, check the device, then use Reconcile After Checking Device before starting another mutation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this screen open while SideStore finishes cleanup. If it remains here, check the device, then use Reconcile After Checking Device before starting another mutation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר מסך זה פתוח בזמן ש-SideStore מסיים את הניקוי. אם הוא נשאר כאן, יש לבדוק את המכשיר ולהשתמש ב'התאמת המצב לאחר בדיקת המכשיר' לפני התחלת פעולה נוספת שמשנה נתונים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持此界面打开，等待 SideStore 完成清理。如果始终停留于此，请检查设备，再使用“检查设备后核对状态”，然后才能开始另一次修改操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持此介面開啟，等待 SideStore 完成清理。如果始終停留於此，請檢查裝置，再使用「檢查裝置後核對狀態」，然後才能開始另一次修改操作。"
          }
        }
      }
    },
    "Keep this screen open while SideStore reconciles the result. Do not start another operation yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this screen open while SideStore reconciles the result. Do not start another operation yet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר מסך זה פתוח בזמן ש-SideStore מתאים את המצב לתוצאה. עדיין אין להתחיל פעולה נוספת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持此界面打开，等待 SideStore 核对结果。暂时不要开始其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持此介面開啟，等待 SideStore 核對結果。暫時不要開始其他操作。"
          }
        }
      }
    },
    "Keep this screen open while SideStore waits for the delete callback. Do not retry until the result is confirmed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this screen open while SideStore waits for the delete callback. Do not retry until the result is confirmed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר מסך זה פתוח בזמן ש-SideStore ממתין להודעת השלמת המחיקה. אין לנסות שוב עד לאישור התוצאה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持此界面打开，等待 SideStore 收到删除回调。在结果确认前，请勿重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持此介面開啟，等待 SideStore 收到刪除回呼。在結果確認前，請勿重試。"
          }
        }
      }
    },
