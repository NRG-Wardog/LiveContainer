    "Authentication succeeded, but SideStore could not confirm that account and team activation was saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication succeeded, but SideStore could not confirm that account and team activation was saved."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימות הצליח, אך SideStore לא הצליח לאשר שהפעלת החשבון והצוות נשמרה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证成功，但 SideStore 无法确认账户和团队的激活状态是否已保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分驗證成功，但 SideStore 無法確認帳號和團隊的啟用狀態是否已儲存。"
          }
        }
      }
    },
    "Authentication succeeded, but provisioning could not save the account or certificate on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication succeeded, but provisioning could not save the account or certificate on this device."
