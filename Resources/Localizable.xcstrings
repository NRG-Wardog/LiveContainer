        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימות הצליח, אך בתהליך הכנת המכשיר לא ניתן לשמור את החשבון או את תעודת החתימה במכשיר זה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证成功，但设备配置过程中无法在此设备上保存账户或证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分驗證成功，但裝置佈建過程中無法在此裝置上儲存帳號或憑證。"
