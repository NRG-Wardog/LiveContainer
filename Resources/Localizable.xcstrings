    "lc.settings.jitLessDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنحك دون-JIT أن تستعمل LiveContainer دون الحاجة لتفعيل JIT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit JIT-less können Sie LiveContainer verwenden, ohne JIT aktivieren zu müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less allows you to use LiveContainer without having to enable JIT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-Less te permite usar LiveContainer sin necesidad de activar JIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode sans JIT vous permet d'utiliser LiveContainer sans avoir à activer le JIT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less ti permette di usare LiveContainer senza dover abilitare JIT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JITレスは、JITを有効化せずにLiveContainerを使用することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer를 사용하려면 JIT가 필요합니다. JIT 없이 사용하려면 JIT-Less을 활성화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb JIT-Less pozwala Ci używać LiveContainer bez włączenia JIT."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo JIT-Less permite que LiveContainer seja usado sem a necessidade do JIT. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим JIT-less позволяет вам использовать LiveContainer без разрешения JIT."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less låter dig använda LiveContainer utan att behöva aktivera JIT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less, JIT'yi etkinleştirmenize gerek kalmadan LiveContainer'ı kullanmanızı sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less cho phép bạn dùng LiveContainer không cần JIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置免JIT模式后，LiveContainer无需JIT即可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免JIT模式能讓您在沒有JIT的情況下使用LiveContainer。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצב ללא JIT מאפשר להשתמש ב-LiveContainer בלי להפעיל JIT."
          }
        }
      }
    },
    "lc.settings.jitlessDiagnose": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
