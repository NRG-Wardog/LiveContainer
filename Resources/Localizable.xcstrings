          }
        }
      }
    },
    "SideStore uses its active certificate for signing, refresh, and installation. LiveContainer keeps a separate JIT-Less certificate copy. JIT-Less certificate status does not by itself mean SideStore refresh used that copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore uses its active certificate for signing, refresh, and installation. LiveContainer keeps a separate JIT-Less certificate copy. JIT-Less certificate status does not by itself mean SideStore refresh used that copy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore משתמש בתעודת החתימה הפעילה שלו לחתימה, לרענון ולהתקנה. LiveContainer שומר עותק נפרד של תעודת חתימה למצב ללא JIT. מצב התעודה למצב ללא JIT לבדו אינו מעיד שרענון SideStore השתמש בעותק הזה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 使用其当前证书进行签名、刷新和安装。LiveContainer 保留单独的 JIT-Less 证书副本。仅凭 JIT-Less 证书状态，不能判断 SideStore 刷新使用了该副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 使用其目前憑證進行簽署、重新整理和安裝。LiveContainer 保留單獨的 JIT-Less 憑證副本。僅憑 JIT-Less 憑證狀態，不能判斷 SideStore 重新整理使用了該副本。"
          }
        }
      }
    },
    "SideStore was busy with another request, so it did not confirm adding this source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore was busy with another request, so it did not confirm adding this source."
