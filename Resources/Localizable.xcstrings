{
  "sourceLanguage": "en",
  "strings": {
    "\nA retained guest still owns this container. Close its existing window before relaunching.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nA retained guest still owns this container. Close its existing window before relaunching."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\nיישום מתארח שנשמר עדיין מחזיק במכל זה. יש לסגור את החלון הקיים שלו לפני הפעלה מחדש."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n保留的客体应用仍占用此容器。请先关闭其现有窗口，再重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n保留的客體應用程式仍佔用此容器。請先關閉其現有視窗，再重新啟動。"
          }
        }
      }
    },
    " (exp ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (exp "
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " (תוקף "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " (到期时间 "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " (到期時間 "
          }
        }
      }
    },
    " Checking the saved provisioning state before another attempt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Checking the saved provisioning state before another attempt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " בודק את מצב הכנת המכשיר שנשמר לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 正在检查已保存的设备配置状态，然后再尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 正在檢查已儲存的裝置佈建狀態，然後再嘗試。"
          }
        }
      }
    },
    " The exact underlying cause could not be safely identified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The exact underlying cause could not be safely identified."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " לא ניתן לזהות בבטחה את הסיבה המדויקת שבבסיס הבעיה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 无法可靠地确定具体根本原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 無法可靠地確定具體根本原因。"
          }
        }
      }
    },
    " and erase its data and backups": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and erase its data and backups"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " ולמחוק את הנתונים והגיבויים שלו"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 并清除其数据和备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 並清除其資料和備份"
          }
        }
      }
    },
    " completed successfully.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " completed successfully."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " (הפעולה הושלמה בהצלחה)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 已成功完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 已成功完成。"
          }
        }
      }
    },
    " completed, but SideStore has not confirmed that its backend session settled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " completed, but SideStore has not confirmed that its backend session settled."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " (הפעולה הושלמה, אך SideStore עדיין לא אישר שתהליך השירות שלו הסתיים)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 已完成，但 SideStore 尚未确认其后端会话已结束处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 已完成，但 SideStore 尚未確認其後端工作階段已結束處理。"
          }
        }
      }
    },
    " from library and erase its backups": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " from library and erase its backups"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " מהספרייה ולמחוק את הגיבויים שלו"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 从资料库中移除并清除其备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 從資料庫中移除並清除其備份"
          }
        }
      }
    },
