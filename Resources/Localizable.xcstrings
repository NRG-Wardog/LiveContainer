    "Open Sources and reload the list to see whether the source was saved before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sources and reload the list to see whether the source was saved before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'מקורות' ולטעון מחדש את הרשימה כדי לבדוק אם המקור נשמר לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
