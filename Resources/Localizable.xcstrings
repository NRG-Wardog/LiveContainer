    "lc.settings.dontSignDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer لا يوقع التطبيقات الجديدة حتى أطفاء هذا الخيار. عند تثبيت التطبيق مع هذه الميزة مفعله سوف يكون التطبيق غير مُوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer wird neue Apps nicht signieren, bis diese Option ausgeschaltet ist. Eine App, die installiert wird, während diese Option aktiviert ist, bleibt unsigniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer will not sign new apps until this option is off. When this option is on the app installed will remain unsigned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer no firmará apps nuevas mientras esta opción esté activada. Con esta opción activada, la app instalada permanecerá sin firmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer ne signera pas de nouvelles applications tant que cette option est activée. Les applications installées pendant que cette option est activée resteront non signées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer non firmerà le nuove app fino a quando questa opzione non è attiva. Le app installate durante questa opzione rimarranno non firmate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定をオンにすると、LiveContainerは新しくインストールするアプリに署名しません。以前にインストールしたアプリにこの設定の影響はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 활성화할 경우 새로 설치되는 앱은 서명되지 않은 상태로 설치됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer nie będzie podpisywał nowych aplikacji, dopóki ta opcja będzie wyłączona. Gdy ta opcja jest włączona, zainstalowane aplikacje pozostaną niepodpisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LiveContainer não assinará novos aplicativos até que esta opção esteja desligada. Quaisquer aplicativos que serão instalados quando esta opção estiver ligada permanecerão sem assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока эта опция включена, LiveContainer не будет подписывать новые приложения. Приложения, установленные с этой включенной опцией, останутся неподписанными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer kommer inte att signera nya appar förrän det här alternativet är avstängt. Appen är installerad medans det här alternativet är på kommer att förbli osignerad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer, bu seçenek kapalı olana kadar yeni uygulamaları imzalamayacaktır. Bu seçenek açıkken yüklenen uygulamalar imzalanmamış olarak kalacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer sẽ không ký các app mới đến khi tắt tuỳ chọn này đi. Các app được cài đặt trong khi bật tuỳ chọn này sẽ không được ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选项启用时LiveContainer不会签名新App。此选项启用期间安装的App会保持未签名状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開此選項時LiveContainer不會簽署新App。啟用此選項期間安裝的App會保持未簽署狀態。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer לא יחתום על יישומים חדשים כל עוד אפשרות זו מופעלת. יישומים שיותקנו בזמן שהיא מופעלת יישארו ללא חתימה."
          }
        }
      }
    },
