    "Reload Sources and confirm whether the source is gone. If it remains, remove it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Sources and confirm whether the source is gone. If it remains, remove it again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את 'מקורות' ולוודא אם המקור הוסר. אם הוא עדיין קיים, יש להסיר אותו שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载源并确认该源是否已移除。如果仍存在，请再次移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入來源並確認該來源是否已移除。如果仍存在，請再次移除。"
          }
        }
      }
    },
    "Reload Status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
