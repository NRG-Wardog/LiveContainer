            "value": "操作已取消。"
          }
        }
      }
    },
    "The operation was not confirmed as stopped, so its staged IPA was kept safely. Reconnect before cleanup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was not confirmed as stopped, so its staged IPA was kept safely. Reconnect before cleanup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא אושר שהפעולה הופסקה, ולכן קובץ ה-IPA שהוכן עבורה נשמר בבטחה. יש להתחבר מחדש לפני ניקוי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认操作已停止，因此暂存的 IPA 已安全保留。请重新连接后再清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未確認操作已停止，因此暫存的 IPA 已安全保留。請重新連線後再清理。"
          }
        }
      }
    },
    "The original reply is unavailable. Inspect the exact request before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original reply is unavailable. Inspect the exact request before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התגובה המקורית אינה זמינה. יש לבדוק את הבקשה המדויקת לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始响应不可用。请先检查具体请求，再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始回應不可用。請先檢查具體請求，再重試。"
          }
        }
      }
    },
    "The pending certificate request still needs attention. If Retry Provisioning is available below, use it to finish signing setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending certificate request still needs attention. If Retry Provisioning is available below, use it to finish signing setup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשה הממתינה לתעודת חתימה עדיין דורשת טיפול. אם האפשרות 'ניסיון חוזר להכנת המכשיר' זמינה למטה, יש להשתמש בה כדי להשלים את הגדרת החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理的证书请求仍需处理。如果下方提供“重试设备配置”，请使用该选项完成签名设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待處理的憑證請求仍需處理。如果下方提供「重試裝置佈建」，請使用該選項完成簽署設定。"
          }
        }
      }
    },
    "The pending certificate state could not be verified. Reload status before continuing. The saved request has not been discarded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending certificate state could not be verified. Reload status before continuing. The saved request has not been discarded."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את מצב תעודת החתימה הממתינה. יש לטעון מחדש את המצב לפני המשך הפעולה. הבקשה השמורה לא נמחקה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证待处理的证书状态。请重新加载状态后再继续。已保存的请求未被丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證待處理的憑證狀態。請重新載入狀態後再繼續。已儲存的請求未被丟棄。"
          }
        }
      }
    },
    "The picker belongs to this screen; the service only parses and stores the file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picker belongs to this screen; the service only parses and stores the file."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בורר הקבצים שייך למסך זה; השירות רק מפענח ומאחסן את הקובץ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择器属于此界面；服务仅解析和保存文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取器屬於此介面；服務僅解析和儲存檔案。"
          }
        }
      }
    },
    "The previous operation has not settled. Check the device; do not start another mutation until the result is reconciled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous operation has not settled. Check the device; do not start another mutation until the result is reconciled."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה הקודמת עדיין לא הגיעה למצב סופי. יש לבדוק את המכשיר; אין להתחיל פעולה נוספת שמשנה נתונים עד להתאמת המצב לתוצאה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次操作尚未结束处理。请检查设备；在结果核对完成之前，请勿开始其他修改操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次操作尚未結束處理。請檢查裝置；在結果核對完成之前，請勿開始其他修改操作。"
          }
        }
      }
    },
    "The previous operation result remains unknown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous operation result remains unknown."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאת הפעולה הקודמת נותרת לא ידועה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次操作的结果仍未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次操作的結果仍未知。"
          }
        }
      }
    },
    "The previous process ended before recording completion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous process ended before recording completion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התהליך הקודם הסתיים לפני שנרשמה השלמתו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一个进程在记录完成状态之前已结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一個程序在記錄完成狀態之前已結束。"
          }
        }
      }
    },
    "The previous refresh result is uncertain. Automatic retries are paused. Review app status and expiration before explicitly retrying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous refresh result is uncertain. Automatic retries are paused. Review app status and expiration before explicitly retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאת הרענון הקודם אינה ודאית. ניסיונות חוזרים אוטומטיים מושהים. יש לבדוק את מצב היישומים ואת תוקפם לפני ייזום ניסיון חוזר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次刷新结果不确定。自动重试已暂停。请先检查应用状态和到期时间，再手动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次重新整理結果不確定。自動重試已暫停。請先檢查應用程式狀態和到期時間，再手動重試。"
          }
        }
      }
    },
    "The previous request was reconciled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous request was reconciled."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצב הותאם לבקשה הקודמת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次请求已核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次請求已核對。"
          }
        }
      }
    },
    "The provisioning retry could not be started, and SideStore could not confirm the account state. Check Account & Signing, then reload status.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provisioning retry could not be started, and SideStore could not confirm the account state. Check Account & Signing, then reload status."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחיל את הניסיון החוזר להכנת המכשיר, ו-SideStore לא הצליח לאשר את מצב החשבון. יש לבדוק את 'חשבון וחתימה' ואז לטעון מחדש את המצב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始设备配置重试，且 SideStore 无法确认账户状态。请检查“账户与签名”，然后重新加载状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開始裝置佈建重試，且 SideStore 無法確認帳號狀態。請檢查「帳號與簽署」，然後重新載入狀態。"
          }
        }
      }
    },
    "The provisioning service could not be reached for this request. Retry once. If it happens again, open Connection Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provisioning service could not be reached for this request. Retry once. If it happens again, open Connection Settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להגיע לשירות ההקצאה עבור בקשה זו. יש לנסות פעם נוספת. אם זה קורה שוב, יש לפתוח את הגדרות החיבור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求无法连接设备配置服务。请重试一次。如果再次发生，请打开连接设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求無法連線裝置佈建服務。請重試一次。如果再次發生，請開啟連線設定。"
          }
        }
      }
    },
    "The provisioning service did not respond during signing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provisioning service did not respond during signing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות ההקצאה לא הגיב במהלך החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备配置服务在签名期间未响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置佈建服務在簽署期間未回應。"
          }
        }
      }
    },
    "The provisioning service returned an invalid response during signing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provisioning service returned an invalid response during signing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות ההקצאה החזיר תגובה לא תקינה במהלך החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备配置服务在签名期间返回了无效响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置佈建服務在簽署期間返回了無效回應。"
          }
        }
      }
    },
    "The provisioning service timed out for this request. Retry once. If it happens again, open Connection Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provisioning service timed out for this request. Retry once. If it happens again, open Connection Settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן שהוקצב לשירות ההקצאה הסתיים עבור בקשה זו. יש לנסות פעם נוספת. אם זה קורה שוב, יש לפתוח את הגדרות החיבור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求的设备配置服务已超时。请重试一次。如果再次发生，请打开连接设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求的裝置佈建服務已逾時。請重試一次。如果再次發生，請開啟連線設定。"
          }
        }
      }
    },
    "The recovered certificate will become active and replace the current active certificate. Existing certificates will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovered certificate will become active and replace the current active certificate. Existing certificates will be kept."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תעודת החתימה ששוחזרה תהפוך לפעילה ותחליף את התעודה הפעילה הנוכחית. התעודות הקיימות יישמרו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复的证书将被激活，并替换当前使用的证书。现有证书将保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復的憑證將被啟用，並替換目前使用的憑證。現有憑證將保留。"
          }
        }
      }
    },
    "The recovery hold was cleared after your device check.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery hold was cleared after your device check."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת השחזור הוסרה לאחר בדיקת המכשיר שלך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你检查设备后，恢复暂停已解除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你檢查裝置後，恢復暫停已解除。"
          }
        }
      }
    },
    "The recovery record cannot be read. Use the recovery banner after checking the device before starting another operation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery record cannot be read. Use the recovery banner after checking the device before starting another operation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את רשומת השחזור. יש להשתמש בבאנר השחזור לאחר בדיקת המכשיר ולפני התחלת פעולה נוספת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取恢复记录。请先检查设备并使用恢复横幅，然后再开始其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取恢復記錄。請先檢查裝置並使用恢復橫幅，然後再開始其他操作。"
          }
        }
      }
    },
    "The recovery record is absent and SideStore status was verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery record is absent and SideStore status was verified."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומת השחזור אינה קיימת ומצב SideStore אומת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录不存在，且 SideStore 状态已验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復記錄不存在，且 SideStore 狀態已驗證。"
          }
        }
      }
    },
    "The refresh could not verify the installed host profile because its handoff record or baseline is incomplete. Review Refresh history and app expiration before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The refresh could not verify the installed host profile because its handoff record or baseline is incomplete. Review Refresh history and app expiration before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרענון לא הצליח לאמת את פרופיל היישום המארח המותקן מפני שרשומת העברת השליטה שלו או נתוני הבסיס אינם שלמים. יש לבדוק את היסטוריית הרענונים ואת תוקף היישומים לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于交接记录或基线不完整，此次刷新无法验证已安装宿主应用的描述文件。请先检查刷新历史记录和应用到期时间，再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於交接記錄或基線不完整，此次重新整理無法驗證已安裝宿主應用程式的描述檔。請先檢查重新整理歷史記錄和應用程式到期時間，再重試。"
          }
        }
      }
    },
    "The refresh hold was cleared after your device check.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The refresh hold was cleared after your device check."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת הרענון הוסרה לאחר בדיקת המכשיר שלך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你检查设备后，刷新暂停已解除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你檢查裝置後，重新整理暫停已解除。"
          }
        }
      }
    },
    "The remote certificate may exist, but local storage was not verified. Check before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote certificate may exist, but local storage was not verified. Check before trying again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שתעודת החתימה המרוחקת קיימת, אך האחסון המקומי לא אומת. יש לבדוק לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程证书可能存在，但本地存储尚未验证。请先检查再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端憑證可能存在，但本地儲存尚未驗證。請先檢查再試。"
          }
        }
      }
    },
    "The requested RSD device service could not be connected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested RSD device service could not be connected."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחבר לשירות המכשיר המבוקש דרך RSD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接请求的 RSD 设备服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線請求的 RSD 裝置服務。"
          }
        }
      }
    },
    "The requested provisioning profile was unavailable. Keep the diagnostics before trying the install again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested provisioning profile was unavailable. Keep the diagnostics before trying the install again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרופיל ההקצאה המבוקש לא היה זמין. יש לשמור את פרטי האבחון לפני ניסיון התקנה נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求的描述文件不可用。请保留诊断信息，然后再尝试安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求的描述檔不可用。請保留診斷資訊，然後再嘗試安裝。"
          }
        }
      }
    },
    "The result needs a manual account or device check before the recovery hold can be cleared.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result needs a manual account or device check before the recovery hold can be cleared."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאה דורשת בדיקה ידנית של החשבון או המכשיר לפני שניתן להסיר את חסימת השחזור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此结果需要手动检查账户或设备后，才能解除恢复暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此結果需要手動檢查帳號或裝置後，才能解除恢復暫停。"
          }
        }
      }
    },
    "The retry could not be confirmed as started. The previous operation may still be active. Previous attempt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retry could not be confirmed as started. The previous operation may still be active. Previous attempt: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר שהניסיון החוזר התחיל. ייתכן שהפעולה הקודמת עדיין פעילה. הניסיון הקודם: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认重试已开始。上一次操作可能仍在进行。上一次尝试：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認重試已開始。上一次操作可能仍在進行。上一次嘗試：%@"
          }
        }
      }
    },
    "The retry could not start because another SideStore operation is still active. Previous attempt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retry could not start because another SideStore operation is still active. Previous attempt: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחיל את הניסיון החוזר מפני שפעולה אחרת של SideStore עדיין פעילה. הניסיון הקודם: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 SideStore 操作仍在进行，因此无法开始重试。上一次尝试：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 SideStore 操作仍在進行，因此無法開始重試。上一次嘗試：%@"
          }
        }
      }
    },
    "The retry could not start, so the app operation did not run. Previous attempt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retry could not start, so the app operation did not run. Previous attempt: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחיל את הניסיון החוזר, ולכן הפעולה ביישום לא בוצעה. הניסיון הקודם: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试无法开始，因此应用操作未执行。上一次尝试：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試無法開始，因此應用程式操作未執行。上一次嘗試：%@"
          }
        }
      }
    },
    "The retry could not start. %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retry could not start. %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחיל את הניסיון החוזר. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试无法开始。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試無法開始。%@"
          }
        }
      }
    },
    "The same request cannot fix this reply-encoding failure. Copy Diagnostics and report that the service could not encode its response.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same request cannot fix this reply-encoding failure. Copy Diagnostics and report that the service could not encode its response."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אותה בקשה אינה יכולה לתקן כשל זה בקידוד התגובה. יש להעתיק את פרטי האבחון ולדווח שהשירות לא הצליח לקודד את התגובה שלו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同请求无法修复此响应编码失败。请复制诊断信息并报告服务无法编码响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同請求無法修復此回應編碼失敗。請複製診斷資訊並報告服務無法編碼回應。"
          }
        }
      }
    },
    "The saved Apple account is signed in. Provisioning is blocked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved Apple account is signed in. Provisioning is blocked."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון Apple השמור מחובר. הכנת המכשיר חסומה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 Apple 账户已登录。设备配置被阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的 Apple 帳號已登入。裝置佈建被阻止。"
          }
        }
      }
    },
    "The saved Apple session is no longer valid. Sign in again with this Apple ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved Apple session is no longer valid. Sign in again with this Apple ID."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן Apple השמור אינו תקף עוד. יש להיכנס שוב עם Apple ID זה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 Apple 会话已失效。请使用此 Apple ID 重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的 Apple 工作階段已失效。請使用此 Apple ID 重新登入。"
          }
        }
      }
    },
    "The saved operation identity is invalid. Check the device before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved operation identity is invalid. Check the device before continuing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהות הפעולה השמורה אינה תקינה. יש לבדוק את המכשיר לפני המשך הפעולה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的操作标识无效。请检查设备后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的操作識別無效。請檢查裝置後再繼續。"
          }
        }
      }
    },
    "The saved provisioning session is no longer available. Open Account & Signing to reauthenticate before retrying setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved provisioning session is no longer available. Open Account & Signing to reauthenticate before retrying setup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן הכנת המכשיר השמור אינו זמין עוד. יש לפתוח את 'חשבון וחתימה' ולעבור אימות מחדש לפני ניסיון נוסף להגדרה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的设备配置会话已不可用。请打开“账户与签名”重新进行身份验证，再重试设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的裝置佈建工作階段已不可用。請開啟「帳號與簽署」重新進行身分驗證，再重試設定。"
          }
        }
      }
    },
    "The saved provisioning session is no longer available. Open Account & Signing to sign in again before retrying setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved provisioning session is no longer available. Open Account & Signing to sign in again before retrying setup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן הכנת המכשיר השמור אינו זמין עוד. יש לפתוח את 'חשבון וחתימה' ולהיכנס שוב לפני ניסיון נוסף להגדרה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的设备配置会话已不可用。请打开“账户与签名”重新登录，再重试设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的裝置佈建工作階段已不可用。請開啟「帳號與簽署」重新登入，再重試設定。"
          }
        }
      }
    },
    "The saved setting could not be verified. Reload settings to check its value.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved setting could not be verified. Reload settings to check its value."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את ההגדרה שנשמרה. יש לטעון מחדש את ההגדרות כדי לבדוק את ערכה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证已保存的设置。请重新加载设置以检查其值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證已儲存的設定。請重新載入設定以檢查其值。"
          }
        }
      }
    },
    "The secure channel to the embedded service could not be locked. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secure channel to the embedded service could not be locked. Try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לנעול את הערוץ המאובטח לשירות המוטמע. יש לנסות שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法锁定通往内嵌服务的安全通道。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法鎖定通往內嵌服務的安全通道。請重試。"
          }
        }
      }
    },
    "The secure response could not be cleared from secure storage. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secure response could not be cleared from secure storage. Try again."
          }
        },
        "he": {
          "stringUnit": {
