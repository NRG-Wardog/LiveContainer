    "Swipe right to reveal Delete, or use Select to delete several entries. Deleting history does not change refresh status or scheduled tasks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to reveal Delete, or use Select to delete several entries. Deleting history does not change refresh status or scheduled tasks."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה ימינה תציג את 'מחיקה'. אפשר גם להשתמש ב'בחירה' למחיקת כמה רשומות. מחיקת היסטוריה אינה משנה את מצב הרענון או את המשימות המתוזמנות."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右轻扫以显示“删除”，或使用“选择”删除多条记录。删除历史记录不会更改刷新状态或定时任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向右輕掃以顯示「刪除」，或使用「選取」刪除多條記錄。刪除歷史記錄不會更改重新整理狀態或排程任務。"
          }
        }
      }
    },
