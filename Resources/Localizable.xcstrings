    "SideStore could not confirm removal of the saved Apple sign-in data. Sign Out stopped, and any partial changes were rolled back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore could not confirm removal of the saved Apple sign-in data. Sign Out stopped, and any partial changes were rolled back."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore לא הצליח לאשר את הסרת נתוני הכניסה השמורים של Apple. היציאה מהחשבון הופסקה וכל השינויים החלקיים בוטלו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 无法确认已保存的 Apple 登录数据已移除。退出登录已停止，所有部分更改均已回滚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 無法確認已儲存的 Apple 登入資料已移除。登出已停止，所有部分更改均已復原。"
          }
        }
      }
    },
    "SideStore could not confirm that the deleted app disappeared from its installed library.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore could not confirm that the deleted app disappeared from its installed library."
          }
        },
        "he": {
