        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניסיון כניסה זה הסתיים. יש להתחיל כניסה חדשה; Apple תבקש קוד אימות חדש לאחר קבלת פרטי הכניסה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次登录尝试已结束。请开始新的登录；凭据被接受后，Apple 将要求提供新的验证码。"
