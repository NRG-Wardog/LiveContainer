    "lc.guestTweak.appSwitchTip %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد بالتحويل إلى %@؟ الفعل هذا سيتسبب بأغلاق هذا التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie zu \"%@\" wechseln wollen? Dadurch wird diese App beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to switch to %@? Doing so will terminate this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres cambiar a %@? Hacerlo cerrará esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment ouvrir %@ ? Cela entraînera la fermeture de cette application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler passare ad %@? Così facendo terminerà questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に切り替えてもよろしいですか？この操作により、このアプリは終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(을)를 실행할 경우 현재 앱은 종료됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz zmienić na %@? Zakończy to pracę tej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que deseja alternar para %@? Fazer tal ação encerrará este aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы точно хотите переключиться на %@? Переключившись, вы завершите работу текущего приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill byta till %@? Om du gör det kommer appen att avslutas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'ye geçmek istediğinizden emin misiniz? Bunu yaparsanız bu uygulama sonlandırılacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn chuyển sang %@? App hiện tại sẽ bị thoát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到%@将终止当前App，要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換到%@會停止目前App，要繼續嗎？"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם לעבור אל %@? פעולה זו תסגור את היישום הנוכחי."
          }
        }
      }
    },
