          }
        }
      }
    },
    "SideStore returned no app installation results. No successful refresh was confirmed. Review eligible apps, account status, and Refresh history before an explicit retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore returned no app installation results. No successful refresh was confirmed. Review eligible apps, account status, and Refresh history before an explicit retry."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore לא החזיר תוצאות התקנה של יישומים. לא אושר רענון מוצלח. יש לבדוק יישומים מתאימים, את מצב החשבון ואת היסטוריית הרענונים לפני ייזום ניסיון חוזר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 未返回应用安装结果。未确认任何刷新成功。请先检查符合条件的应用、账户状态和刷新历史记录，然后再手动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 未返回應用程式安裝結果。未確認任何重新整理成功。請先檢查符合條件的應用程式、帳號狀態和重新整理歷史記錄，然後再手動重試。"
          }
        }
      }
    },
    "SideStore returned without sharing installation results with LiveContainer. Refresh is unconfirmed. Review Refresh history, app expiration, and account status before an explicit retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore returned without sharing installation results with LiveContainer. Refresh is unconfirmed. Review Refresh history, app expiration, and account status before an explicit retry."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore סיים בלי לשתף את תוצאות ההתקנה עם LiveContainer. הרענון לא אושר. יש לבדוק את היסטוריית הרענונים, את תוקף היישומים ואת מצב החשבון לפני ייזום ניסיון חוזר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 返回时未与 LiveContainer 共享安装结果。刷新未确认。请先检查刷新历史记录、应用到期时间和账户状态，然后再手动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 返回時未與 LiveContainer 共享安裝結果。重新整理未確認。請先檢查重新整理歷史記錄、應用程式到期時間和帳號狀態，然後再手動重試。"
          }
        }
      }
    },
    "SideStore status: ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore status: "
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב SideStore: "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 状态： "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 狀態： "
          }
        }
      }
    },
    "SideStore still cannot confirm that the install stopped. No new install was started. Reconnect, then retry cancellation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore still cannot confirm that the install stopped. No new install was started. Reconnect, then retry cancellation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore עדיין לא יכול לאשר שההתקנה הופסקה. לא התחילה התקנה חדשה. יש להתחבר מחדש ואז לנסות לבטל שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 仍无法确认安装已停止。未开始新安装。请重新连接，然后重试取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 仍無法確認安裝已停止。未開始新安裝。請重新連線，然後重試取消。"
          }
        }
      }
    },
    "SideStore still has a saved account or team, but cannot confirm an active Apple sign-in. Sign in again or explicitly sign out of the saved account state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore still has a saved account or team, but cannot confirm an active Apple sign-in. Sign in again or explicitly sign out of the saved account state."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-SideStore עדיין שמורים חשבון או צוות, אך לא ניתן לאשר כניסה פעילה ל-Apple. יש להיכנס שוב או ליזום יציאה ממצב החשבון השמור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 仍有已保存的账户或团队，但无法确认当前 Apple 登录有效。请重新登录，或明确退出已保存的账户状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 仍有已儲存的帳號或團隊，但無法確認目前 Apple 登入有效。請重新登入，或明確退出已儲存的帳號狀態。"
          }
        }
      }
    },
    "SideStore still reports an active sign-in. Sign-out is not confirmed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore still reports an active sign-in. Sign-out is not confirmed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore עדיין מדווח על כניסה פעילה. היציאה מהחשבון לא אושרה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 仍报告存在有效登录。退出登录未确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 仍報告存在有效登入。登出未確認。"
          }
        }
      }
    },
    "SideStore stopped updating this source because its identifier changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore stopped updating this source because its identifier changed."
