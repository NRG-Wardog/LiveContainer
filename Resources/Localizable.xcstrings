          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此待處理憑證已準備好啟用。請使用原始 Apple ID 重新登入以完成簽署設定。"
          }
        }
      }
    },
    "This pending request belongs to another Apple ID. Return to Account and Signing, sign out, then sign in with the original Apple ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
