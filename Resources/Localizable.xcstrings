    "lc.settings.appGroupExist Shared": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ملفات في مجلد مجموعه التطبيقات المُشارَكه. قم بنقلها اولاً قم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ordner der freigegebenen App-Gruppe befinden sich Dateien. Verschieben Sie sie zuerst und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are files in the shared app group folder. Move them out first and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay archivos en la carpeta compartida del grupo de apps. Muévelos primero e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a des fichiers dans le dossier partagé du groupe d'apps. Déplacez-les d'abord et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono dei file nella cartella privata del gruppo di app. Spostali e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アプリグループフォルダにファイルがあります。ファイルを移動してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 앱 그룹 폴더에 있는 파일을 옮긴 후 다시 시도해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W katalogu Dzielonych Aplikacji znajdują się pliki. Przenieś je w inne miejsce i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem arquivos na sua pasta de aplicativos agrupados compartilhados. Mova-os primeiro e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В общем App Group присутствуют файлы. Сначала переместите их, затем попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns filer i mappen för delade appgrupper. Flytta ut den först och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan uygulama grubu klasöründe dosyalar var. Önce bunları taşıyın ve tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có file trong thư mục app group chung. Hãy di chuyển nó ra rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享的AppGroup文件夹中不为空。将其中文件移动出来后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享 AppGroup 資料夾有文件。移出文件並重試。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש קבצים בתיקיית קבוצת היישומים המשותפת. יש להעביר אותם ממנה ולנסות שוב."
          }
        }
      }
    },
