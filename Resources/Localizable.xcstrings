          }
        }
      }
    },
    "Open Sources and use the existing source. Remove it only after confirming which entry is correct.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sources and use the existing source. Remove it only after confirming which entry is correct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'מקורות' ולהשתמש במקור הקיים. יש להסיר אותו רק לאחר אימות איזו רשומה נכונה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“源”并使用现有源。只有在确认哪个条目正确后，才能移除源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「來源」並使用現有來源。只有在確認哪個條目正確後，才能移除來源。"
          }
        }
      }
    },
    "Open Sources to confirm the source is still added, then reopen its catalog.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sources to confirm the source is still added, then reopen its catalog."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
