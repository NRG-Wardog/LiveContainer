    "lc.settings.multiLCLaunchPriorityDesc": {
      "comment": "Drag LiveContainers to choose which one is tried first when launching shared apps.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب LiveContainers لاختيار أي واحد يتم تجربته أولا عند تشغيل التطبيقات المشتركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die LiveContainer, um festzulegen, welche App zuerst gestartet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag LiveContainers to choose which one is tried first when launching shared apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los Live Containers para elegir cuál se intenta primero al lanzar apps compartidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les LiveContainers pour choisir lequel est essayé en premier lors du lancement d'applications partagées."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij LiveContainers, aby wybrać, który z nich zostanie wypróbowany jako pierwszy podczas uruchamiania udostępnionych aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте LiveContainer'ы, чтобы выбрать, какой из них будет использован при запуске общих приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan uygulamalar başlatılırken önce hangisinin deneneceğini belirlemek için LiveContainer’ları sürükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các LiveContainer để chọn cái nào được thử trước khi chạy app được chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动 LiveContainer 来设置启动共享 App 时的尝试顺序。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לגרור את מופעי LiveContainer כדי לבחור באיזה מהם ייעשה ניסיון הפעלה ראשון של יישומים משותפים."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 LiveContainer，以選擇啟動共享應用程式時優先嘗試的順序。"
          }
        }
      }
    },
