    "lc.settings.multiLCInstallAlertDesc %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يقوم LiveContainer بتوليد ملف الـipa لـLiveContainer أخر. الرجاء مشاركته إلى %@ للتثبيت، هل تود المتابعه؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer wird eine IPA für einen weiteren LiveContainer generieren. Bitte teilen Sie diese mit %@, um sie zu installieren. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer will generate the ipa for another LiveContainer. Please share it to %@ to install it, Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer generará el ipa para otro LiveContainer. Compártelo con %@ para instalarlo. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer va générer l'IPA pour un autre LiveContainer. Veuillez le partager à %@ pour l'installer. Continuer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer genererà l'ipa per un altro LiveContainer. Condividilo su %@ per installarlo, Vuoi Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainerは別のLiveContainer用のIPAを生成します。インストールするには%@に共有してください。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 다운로드가 완료되면, %@(으)로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer wygeneruje plik ipa dla innego LiveContainer. Proszę udostępnić go do %@ aby go zainstalować. Czy chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner atual irá gerar o arquivo IPA para outro contêiner. Por favor, compartilhe-o para %@ para concluir a instalação. Deseja continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer создаст файл IPA для другого LiveContainer'а. Поделитесь им с %@, чтобы завершить установку. Хотите продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer kommer att generera ipa för en annan LiveContainer. Vänligen dela den till %@ för att installera den, Fortsätt?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer, başka bir LiveContainer için ipa dosyası oluşturacaktır. Yüklemek için lütfen %@ ile paylaşın, devam etmek ister misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer sẽ tạo file ipa cho LiveContainer khác. Hãy chia sẻ nó qua %@ để cài nó. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer将会生成另一个LiveContainer的IPA，请将其分享至%@以安装。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer 會產生另一個 LiveContainer 的 IPA。請將它分享到 %@ 以進行安裝。要繼續嗎？"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer ייצור קובץ IPA למופע נוסף של LiveContainer. יש לשתף את הקובץ עם %@ כדי להתקין אותו. להמשיך?"
          }
        }
      }
    },
