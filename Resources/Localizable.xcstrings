    "SideStore is using a different or newer signing certificate than the JIT-Less certificate stored by LiveContainer. Refresh the JIT-Less certificate copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore is using a different or newer signing certificate than the JIT-Less certificate stored by LiveContainer. Refresh the JIT-Less certificate copy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore משתמש בתעודת חתימה שונה או חדשה יותר מזו ששמורה ב-LiveContainer למצב ללא JIT. יש לרענן את עותק התעודה למצב ללא JIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 使用的签名证书与 LiveContainer 保存的 JIT-Less 证书不同，或版本更新。请刷新 JIT-Less 证书副本。"
          }
