    "lc.appSettings.hideLiveContainerDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن ان يعبر بعض مكتشفات التعديلات لدى بعض البرامج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Könnte helfen, die Injektionserkennung einiger Apps zu umgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Might help bypass some app’s injection detection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podría ayudar a evitar la detección de inyecciones de alguna aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela pourrait permettre de contourner la détection d'injection de certaines applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe aiutare a bypassare il rilevamento d'iniezione dei tweak in alcune app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のアプリの不正検出を回避できる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 앱 트윅 감지를 우회할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może pomóc z obejściem wykrycia wtrysku u niektórych aplikacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez ajude a ignorar a detecção de injeção de alguns aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может помочь обойти обнаружение инъекции для некоторых приложений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan hjälpa till att kringgå vissa appars injektions detektion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı uygulamaların enjeksiyon algılamasını atlatmaya yardımcı olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể giúp vượt qua các phát hiện inject trong các app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能可以帮助绕过一些App的注入检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能有助於繞過一些應用程式的注入檢測。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עשוי לסייע בעקיפת זיהוי הזרקת קוד ביישומים מסוימים."
          }
        }
      }
    },
