    "The verification code was not accepted. Enter a new code and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification code was not accepted. Enter a new code and try again."
          }
        },
        "he": {
          "stringUnit": {
