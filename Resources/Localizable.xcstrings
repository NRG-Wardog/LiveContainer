          "stringUnit": {
            "state": "translated",
            "value": "重試來源"
          }
        }
      }
    },
    "Retry once. If the configured Anisette server times out again, choose another server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry once. If the configured Anisette server times out again, choose another server."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לנסות פעם נוספת. אם הזמן שהוקצב לשרת Anisette המוגדר יסתיים שוב, יש לבחור שרת אחר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试一次。如果配置的 Anisette 服务器再次超时，请选择其他服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試一次。如果設定的 Anisette 伺服器再次逾時，請選取其他伺服器。"
          }
        }
      }
    },
    "Retry provisioning when the displayed prerequisite is ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry provisioning when the displayed prerequisite is ready."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לנסות להכין את המכשיר שוב כשדרישת הקדם המוצגת מתקיימת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在显示的前提条件满足后重试设备配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在顯示的前提條件滿足後重試裝置佈建。"
          }
        }
      }
    },
    "Return to LC+SS.": {
      "extractionState": "manual",
