            "value": "選取團隊"
          }
        }
      }
    },
    "Choose the development team used for signing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the development team used for signing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור את צוות הפיתוח שישמש לחתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择用于签名的开发者团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選取用於簽署的開發者團隊。"
          }
        }
      }
    },
    "Apple rejected the developer-portal session while loading your teams (1100).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple rejected the developer-portal session while loading your teams (1100)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple דחתה את הסשן בפורטל המפתחים בזמן טעינת הצוותים שלך (1100)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载你的团队时，Apple 拒绝了开发者门户会话 (1100)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入你的團隊時，Apple 拒絕了開發者入口網站工作階段 (1100)。"
          }
        }
      }
    },
    "Choose Finish Later, then Sign In Again to Finish Setup. Retrying provisioning would reuse the rejected session. This happened before certificate setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Finish Later, then Sign In Again to Finish Setup. Retrying provisioning would reuse the rejected session. This happened before certificate setup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור \"סיום מאוחר יותר\" ואז \"כניסה מחדש להשלמת ההגדרה\". ניסיון חוזר להכנת המכשיר ישתמש שוב בסשן שנדחה. הדבר קרה לפני הגדרת תעודת החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择“稍后完成”，然后选择“重新登录以完成设置”。重试设备配置会复用已被拒绝的会话。此问题发生在证书设置之前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選取「稍後完成」，然後選取「重新登入以完成設定」。重試裝置佈建會重複使用已被拒絕的工作階段。此問題發生在憑證設定之前。"
          }
        }
      }
    },
    "Provisioning reached local storage, but the save result could not be confirmed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provisioning reached local storage, but the save result could not be confirmed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנת המכשיר הגיעה לשלב האחסון המקומי, אך לא ניתן לאשר את תוצאת השמירה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备配置已进入本地存储步骤，但无法确认保存结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置佈建已進入本機儲存步驟，但無法確認儲存結果。"
          }
        }
      }
    },
    "Finish Later and reload Account & Signing to reconcile storage before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish Later and reload Account & Signing to reconcile storage before continuing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור \"סיום מאוחר יותר\" ולטעון מחדש את \"חשבון וחתימה\" כדי לבדוק ולהתאים את מצב האחסון לפני שממשיכים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择“稍后完成”，并重新加载“账户与签名”以核对存储状态，然后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選取「稍後完成」，並重新載入「帳號與簽署」以核對儲存狀態，然後再繼續。"
          }
        }
      }
    },
    "Provisioning could not save the required account or signing state on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provisioning could not save the required account or signing state on this device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במהלך הכנת המכשיר לא ניתן היה לשמור את מצב החשבון או החתימה הנדרש במכשיר זה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备配置无法在此设备上保存所需的账户或签名状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置佈建無法在此裝置上儲存所需的帳號或簽署狀態。"
          }
        }
      }
    },
    "Retry repeats this local storage step. If it keeps failing, Finish Later and review the safe diagnostics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry repeats this local storage step. If it keeps failing, Finish Later and review the safe diagnostics."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניסיון חוזר יחזור על שלב האחסון המקומי הזה. אם הכשל נמשך, יש לבחור \"סיום מאוחר יותר\" ולעיין בפרטי האבחון הבטוחים להצגה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试会再次执行此本地存储步骤。如果仍然失败，请选择“稍后完成”并查看经过安全处理的诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試會再次執行此本機儲存步驟。如果仍然失敗，請選取「稍後完成」並查看經過安全處理的診斷資訊。"
          }
        }
      }
    },
    "Provisioning could not be completed because of an unexpected failure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provisioning could not be completed because of an unexpected failure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשלים את הכנת המכשיר עקב כשל לא צפוי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于发生意外故障，无法完成设备配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於發生非預期的故障，無法完成裝置佈建。"
          }
        }
      }
    },
    "You can retry; if it keeps failing, check the account, team, and certificates before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can retry; if it keeps failing, check the account, team, and certificates before trying again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנסות שוב; אם הכשל נמשך, יש לבדוק את החשבון, הצוות ותעודות החתימה לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以重试；如果仍然失败，请先检查账户、团队和证书，再尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以重試；如果仍然失敗，請先檢查帳號、團隊和憑證，再嘗試。"
          }
        }
      }
    },
    "Provisioning Needs Attention": {
      "extractionState": "manual",
      "localizations": {
