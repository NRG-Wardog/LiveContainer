    "Changes remain paused. This is not proof of a corrupt record. Check shared storage and service status; copy Diagnostics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes remain paused. This is not proof of a corrupt record. Check shared storage and service status; copy Diagnostics."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינויים נותרים מושהים. אין בכך הוכחה לרשומה פגומה. יש לבדוק את האחסון המשותף ואת מצב השירות ולהעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改仍处于暂停状态。这并不能证明记录已损坏。请检查共享存储和服务状态，并复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改仍處於暫停狀態。這並不能證明記錄已損壞。請檢查共享儲存和服務狀態，並複製診斷資訊。"
          }
        }
      }
    },
    "Check %@/mount_status for mounting status.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check %@/mount_status for mounting status."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבדוק את מצב העיגון בכתובת %@/mount_status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 %@/mount_status 以了解挂载状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查 %@/mount_status 以瞭解掛載狀態。"
          }
        }
      }
    },
    "Check LocalDevVPN and the device connection, then retry explicitly. This failure alone does not prove invalid pairing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check LocalDevVPN and the device connection, then retry explicitly. This failure alone does not prove invalid pairing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את LocalDevVPN ואת החיבור למכשיר ואז ליזום ניסיון חוזר. כשל זה לבדו אינו מוכיח שהצימוד אינו תקין."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 LocalDevVPN 和设备连接，然后手动重试。仅此故障并不能证明配对无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查 LocalDevVPN 和裝置連線，然後手動重試。僅此故障並不能證明配對無效。"
          }
        }
      }
    },
