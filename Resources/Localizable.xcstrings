    "\"%@\" is not added. Add it, then the operation retries automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not added. Add it, then the operation retries automatically."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" לא נוסף. לאחר הוספתו, הפעולה תנסה שוב אוטומטית."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未添加“%@”。添加后将自动重试此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未新增「%@」。新增後將自動重試此操作。"
          }
        }
      }
    },
