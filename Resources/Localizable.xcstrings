          }
        }
      }
    },
    "Refreshing the JIT-Less copy cannot repair SideStore's active certificate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing the JIT-Less copy cannot repair SideStore's active certificate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רענון העותק למצב ללא JIT אינו יכול לתקן את תעודת החתימה הפעילה של SideStore."
          }
        },
