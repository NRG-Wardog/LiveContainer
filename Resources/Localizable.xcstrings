          }
        }
      }
    },
    "The install screen could not be opened. The attempt was cleared; tap Install / Sideload App again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The install screen could not be opened. The attempt was cleared; tap Install / Sideload App again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפתוח את מסך ההתקנה. הניסיון נוקה; יש להקיש שוב על 'התקנה חיצונית של יישום'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开安装界面。此尝试已清除；请再次轻点“安装 / 侧载应用”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟安裝介面。此嘗試已清除；請再次輕點「安裝 / 側載應用程式」。"
          }
        }
      }
    },
    "The installed host is locally compatible with the active signing setup. Revocation was not checked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed host is locally compatible with the active signing setup. Revocation was not checked."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום המארח המותקן תואם מקומית להגדרת החתימה הפעילה. לא נבדק אם התעודה בוטלה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的宿主应用在本地与当前签名设置兼容。未检查撤销状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的宿主應用程式在本地與目前簽署設定相容。未檢查撤銷狀態。"
          }
        }
      }
    },
    "The installed host profile did not advance after replacement. Retry manually; no success was recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed host profile did not advance after replacement. Retry manually; no success was recorded."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופיל המותקן של היישום המארח לא התחדש לאחר ההחלפה. יש לנסות שוב ידנית; לא נרשמה הצלחה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换后，已安装宿主应用的描述文件未续期。请手动重试；未记录为成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替換後，已安裝宿主應用程式的描述檔未續期。請手動重試；未記錄為成功。"
          }
        }
      }
    },
    "The installed host provisioning profile could not be read or its identity does not match. Refresh success has not been verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed host provisioning profile could not be read or its identity does not match. Refresh success has not been verified."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את פרופיל ההקצאה של היישום המארח המותקן, או שהזהות שלו אינה תואמת. הצלחת הרענון לא אומתה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已安装宿主应用的描述文件，或其身份不匹配。刷新成功尚未验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已安裝宿主應用程式的描述檔，或其身分不相符。重新整理成功尚未驗證。"
          }
        }
      }
    },
    "The installed host signing is expired or differs from the active setup. Run Test Refresh after completing account and certificate setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed host signing is expired or differs from the active setup. Run Test Refresh after completing account and certificate setup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף חתימת היישום המארח המותקן פג, או שהיא שונה מההגדרה הפעילה. יש להריץ רענון בדיקה לאחר השלמת הגדרת החשבון ותעודת החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装宿主应用的签名已过期，或与当前设置不同。请完成账户和证书设置后运行测试刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝宿主應用程式的簽署已過期，或與目前設定不同。請完成帳號和憑證設定後執行測試重新整理。"
          }
        }
      }
    },
    "The installed host uses a different paid-team signer. Its portal status was not checked; a re-sign is not known to be required. You can inspect Certificates or explicitly run Test Refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed host uses a different paid-team signer. Its portal status was not checked; a re-sign is not known to be required. You can inspect Certificates or explicitly run Test Refresh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום המארח המותקן משתמש בזהות חתימה של צוות אחר בתשלום. המצב שלה בפורטל לא נבדק; לא ידוע שנדרשת חתימה מחדש. אפשר לבדוק את 'תעודות חתימה' או ליזום רענון בדיקה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的宿主应用使用不同的付费团队签名者。未检查其门户状态；尚不清楚是否需要重新签名。你可以检查“证书”，或手动运行测试刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的宿主應用程式使用不同的付費團隊簽署者。未檢查其開發者網站狀態；尚不清楚是否需要重新簽署。你可以檢查「憑證」，或手動執行測試重新整理。"
          }
        }
      }
    },
    "The local account activation outcome needs reconciliation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local account activation outcome needs reconciliation."
