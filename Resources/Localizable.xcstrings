            "value": "Para esconder os aplicativos completamente, ative o 'Modo de Ocultação Robusto' nas configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы полностью скрыть приложения, включите строгий режим скрытия в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att helt dölja appar, aktivera Strict Hiding mode i inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaları tamamen gizlemek için ayarlarda Sıkı Gizleme modunu etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ẩn app hoàn toàn, bật chế độ Ẩn Nghiêm Ngặt trong cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要完全隐藏App，请在设置中启用严格隐藏模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
