    "iOS did not register every background refresh task, so refreshes will not run on their own. Manual Refresh All still works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS did not register every background refresh task, so refreshes will not run on their own. Manual Refresh All still works."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא רשמה את כל משימות הרענון ברקע, ולכן הרענונים לא יפעלו מעצמם. האפשרות הידנית 'רענון הכול' עדיין פועלת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未注册全部后台刷新任务，因此刷新不会自动运行。仍可手动执行“全部刷新”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未註冊全部背景重新整理任務，因此重新整理不會自動執行。仍可手動執行「全部重新整理」。"
          }
        }
      }
    },
    "iOS did not register every background task. Manual refresh remains available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS did not register every background task. Manual refresh remains available."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא רשמה את כל משימות הרקע. רענון ידני נשאר זמין."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未注册全部后台任务。仍可手动刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未註冊全部背景任務。仍可手動重新整理。"
          }
        }
      }
    },
    "iOS ended background execution before completion. Open LiveContainer to check the result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ended background execution before completion. Open LiveContainer to check the result."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS סיימה את ההרצה ברקע לפני השלמתה. יש לפתוח את LiveContainer כדי לבדוק את התוצאה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在完成之前结束了后台执行。请打开 LiveContainer 检查结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在完成之前結束了背景執行。請開啟 LiveContainer 檢查結果。"
          }
        }
      }
    },
    "iOS ended the background execution window; refresh was not verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ended the background execution window; refresh was not verified."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS סיימה את חלון ההרצה ברקע; הרענון לא אומת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 结束了后台执行时段；刷新未验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 結束了背景執行時段；重新整理未驗證。"
          }
        }
      }
    },
    "iOS reports that the identity used to sign the executable is no longer valid. The app must be re-signed with a current signing identity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS reports that the identity used to sign the executable is no longer valid. The app must be re-signed with a current signing identity."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מדווחת שזהות החתימה ששימשה לחתימה על קובץ ההפעלה אינה תקפה עוד. יש לחתום על היישום מחדש באמצעות זהות חתימה תקפה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 报告，用于签署可执行文件的身份已失效。必须使用有效的签名身份重新签名应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 報告，用於簽署可執行檔案的身分已失效。必須使用有效的簽署身分重新簽署應用程式。"
          }
        }
      }
    },
    "iOS reports that the provisioning profile is banned during application verification. Recreating pairing or changing LocalDevVPN settings is unlikely to address this specific error.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS reports that the provisioning profile is banned during application verification. Recreating pairing or changing LocalDevVPN settings is unlikely to address this specific error."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מדווחת במהלך אימות היישום שפרופיל ההקצאה חסום. יצירת צימוד מחדש או שינוי הגדרות LocalDevVPN כנראה לא יפתרו שגיאה מסוימת זו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在应用验证期间报告描述文件已被禁用。重新建立配对或更改 LocalDevVPN 设置不太可能解决此特定错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在應用程式驗證期間報告描述檔已被停用。重新建立配對或更改 LocalDevVPN 設定不太可能解決此特定錯誤。"
          }
        }
      }
    },
    "iOS would not accept the next scheduled background refresh. Refresh All still works now; check Settings for Background App Refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS would not accept the next scheduled background refresh. Refresh All still works now; check Settings for Background App Refresh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא קיבלה את הרענון הבא שתוזמן לרקע. האפשרות 'רענון הכול' עדיין פועלת כעת; יש לבדוק בהגדרות את רענון היישומים ברקע."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未接受下一次定时后台刷新。目前仍可使用“全部刷新”；请在“设置”中检查“后台 App 刷新”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未接受下一次排程背景重新整理。目前仍可使用「全部重新整理」；請在「設定」中檢查「背景 App 重新整理」。"
          }
        }
      }
    },
