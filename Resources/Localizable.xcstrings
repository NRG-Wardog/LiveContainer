    "Open Account & Signing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Account & Signing"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת חשבון וחתימה"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“账户与签名”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「帳號與簽署」"
          }
        }
      }
    },
    "Open Account & Signing and choose Check Saved Signing State. Creating or revoking Apple certificates stays blocked until local storage is verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Account & Signing and choose Check Saved Signing State. Creating or revoking Apple certificates stays blocked until local storage is verified."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'חשבון וחתימה' ולבחור ב'בדיקת מצב החתימה השמור'. יצירה או ביטול של תעודות חתימה של Apple יישארו חסומים עד לאימות האחסון המקומי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“账户与签名”并选择“检查已保存的签名状态”。在验证本地存储之前，创建或撤销 Apple 证书的操作仍被阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「帳號與簽署」並選取「檢查已儲存的簽署狀態」。在驗證本地儲存之前，建立或撤銷 Apple 憑證的操作仍被阻止。"
          }
        }
      }
    },
    "Open Account & Signing and complete the required account step.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Account & Signing and complete the required account step."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'חשבון וחתימה' ולהשלים את השלב הנדרש בחשבון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“账户与签名”并完成所需的账户操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「帳號與簽署」並完成所需的帳號操作。"
          }
        }
      }
    },
    "Open Account & Signing and start a new sign-in. SideStore will reconcile the current account before proceeding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Account & Signing and start a new sign-in. SideStore will reconcile the current account before proceeding."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'חשבון וחתימה' ולהתחיל כניסה חדשה. SideStore יתאים את המצב לחשבון הנוכחי לפני שימשיך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“账户与签名”并开始新的登录。SideStore 会先核对当前账户，然后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「帳號與簽署」並開始新的登入。SideStore 會先核對目前帳號，然後再繼續。"
          }
        }
      }
    },
    "Open Account & Signing, complete sign-in, then start a new operation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Account & Signing, complete sign-in, then start a new operation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'חשבון וחתימה', להשלים את הכניסה ואז להתחיל פעולה חדשה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“账户与签名”并完成登录，然后开始新操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「帳號與簽署」並完成登入，然後開始新操作。"
          }
        }
      }
    },
