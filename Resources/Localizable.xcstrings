    "Ask the source provider to correct its metadata, then preview it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the source provider to correct its metadata, then preview it again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבקש מספק המקור לתקן את המטא-נתונים שלו ואז להציג שוב תצוגה מקדימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请联系源提供方修正元数据，然后重新预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請聯繫來源提供方修正中繼資料，然後重新預覽。"
          }
        }
      }
    },
    "Authentication could not obtain valid Anisette data.": {
