        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 SideStore 操作仍在進行，因此無法開始此操作。"
          }
        }
      }
    },
    "The operation could not start, so the app pipeline did not run.": {
      "extractionState": "manual",
