    "SideStore confirmed account status but could not confirm whether this sign-in attempt finished. Cancel the unconfirmed session before starting another attempt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore confirmed account status but could not confirm whether this sign-in attempt finished. Cancel the unconfirmed session before starting another attempt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore אישר את מצב החשבון, אך לא הצליח לאשר אם ניסיון כניסה זה הסתיים. יש לבטל את הסשן שלא אושר לפני התחלת ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 已确认账户状态，但无法确认此次登录尝试是否结束。请先取消未确认的会话，再开始新的尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 已確認帳號狀態，但無法確認此次登入嘗試是否結束。請先取消未確認的工作階段，再開始新的嘗試。"
          }
        }
      }
