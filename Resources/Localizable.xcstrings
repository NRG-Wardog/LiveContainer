    "Tap Test Refresh again to resume this same request; it will not start a duplicate refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Test Refresh again to resume this same request; it will not start a duplicate refresh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש שוב על 'רענון בדיקה' כדי להמשיך באותה בקשה; לא יתחיל רענון כפול."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次轻点“测试刷新”可继续同一请求；不会开始重复刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次輕點「測試重新整理」可繼續同一請求；不會開始重複重新整理。"
          }
        }
      }
    },
