    "Warnings require permission. A deadline warning asks you to check an unconfirmed refresh; it cannot diagnose a task that never ran.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnings require permission. A deadline warning asks you to check an unconfirmed refresh; it cannot diagnose a task that never ran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזהרות דורשות הרשאה. אזהרה על המועד האחרון מבקשת לבדוק רענון שלא אושר; היא אינה יכולה לאבחן משימה שמעולם לא רצה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告需要获得权限。截止时间警告会要求你检查未确认的刷新；它无法诊断根本未运行的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "警告需要獲得權限。截止時間警告會要求你檢查未確認的重新整理；它無法診斷根本未執行的任務。"
          }
        }
      }
    },
