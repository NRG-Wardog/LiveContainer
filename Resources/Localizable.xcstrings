          "stringUnit": {
            "state": "translated",
            "value": "החשבון מחובר ל-Apple ID, אך SideStore לא הצליח לאשר את תוצאת הכנת המכשיר. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID 已登录，但 SideStore 无法确认设备配置结果。 "
