    "The portal holds certificates that block provisioning for a %@ team. Keep the existing certificates or revoke the selected ones.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The portal holds certificates that block provisioning for a %@ team. Keep the existing certificates or revoke the selected ones."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בפורטל קיימות תעודות חתימה שחוסמות את הכנת המכשיר עבור צוות מסוג %@. ניתן להשאיר את התעודות הקיימות או לבטל את התעודות שנבחרו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门户中的证书阻止了 %@ 团队的设备配置。请保留现有证书，或撤销所选证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "入口網站中的憑證阻止了 %@ 團隊的裝置佈建。請保留現有憑證，或撤銷所選憑證。"
          }
        }
      }
    },
    "Host Refresh Needed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host Refresh Needed"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש רענון של היישום המארח"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要刷新宿主应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新整理宿主應用程式"
          }
        }
      }
    },
    "The installed LiveContainer app needs to be refreshed with the active signing certificate (%@). Finish sign-in, then run Refresh All or Test Refresh in Setup Assistant. Sign-in alone does not re-sign the installed app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed LiveContainer app needs to be refreshed with the active signing certificate (%@). Finish sign-in, then run Refresh All or Test Refresh in Setup Assistant. Sign-in alone does not re-sign the installed app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לרענן את יישום LiveContainer המותקן באמצעות תעודת החתימה הפעילה (%@). יש להשלים את הכניסה ואז להפעיל \"רענון הכול\" או \"רענון בדיקה\" באשף ההגדרה. כניסה לבדה אינה חותמת מחדש על היישום המותקן."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用当前签名证书刷新已安装的 LiveContainer 应用 (%@)。请完成登录，然后在设置助理中执行“全部刷新”或“测试刷新”。仅登录不会为已安装的应用重新签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用目前的簽署憑證重新整理已安裝的 LiveContainer 應用程式 (%@)。請完成登入，然後在設定助理中執行「全部重新整理」或「測試重新整理」。僅登入不會重新簽署已安裝的應用程式。"
          }
        }
      }
    },
    "Finish Sign-In": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish Sign-In"
