    "No completed refresh has been confirmed for this deadline. Open LiveContainer to check or refresh. A host replacement may still need verification.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No completed refresh has been confirmed for this deadline. Open LiveContainer to check or refresh. A host replacement may still need verification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא אושר רענון שהושלם עבור מועד אחרון זה. יש לפתוח את LiveContainer כדי לבדוק או לרענן. ייתכן שהחלפת היישום המארח עדיין דורשת אימות."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认有任何刷新在此截止时间前完成。请打开 LiveContainer 检查或刷新。宿主应用替换可能仍需验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未確認有任何重新整理在此截止時間前完成。請開啟 LiveContainer 檢查或重新整理。宿主應用程式替換可能仍需驗證。"
          }
        }
      }
    },
