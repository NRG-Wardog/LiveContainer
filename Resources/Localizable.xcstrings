    "The service lost its refresh owner after the wait limit. Check the device before clearing the hold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service lost its refresh owner after the wait limit. Check the device before clearing the hold."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות איבד את הגורם האחראי לרענון לאחר תום מגבלת ההמתנה. יש לבדוק את המכשיר לפני הסרת החסימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待超时后，服务丢失了刷新负责进程。请检查设备后再解除暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待逾時後，服務遺失了重新整理負責程序。請檢查裝置後再解除暫停。"
          }
        }
      }
    },
    "The service prepared an operation but did not confirm dispatch. Check the device before clearing this hold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service prepared an operation but did not confirm dispatch. Check the device before clearing this hold."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות הכין פעולה אך לא אישר שנשלחה. יש לבדוק את המכשיר לפני הסרת חסימה זו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务已准备好操作，但尚未确认发出。请检查设备后再解除此暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務已準備好操作，但尚未確認發出。請檢查裝置後再解除此暫停。"
          }
        }
      }
    },
    "The service reply exceeded the transfer limit. Copy Diagnostics and report this response-size issue; repeating the same request will fail again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service reply exceeded the transfer limit. Copy Diagnostics and report this response-size issue; repeating the same request will fail again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תגובת השירות חרגה ממגבלת ההעברה. יש להעתיק את פרטי האבחון ולדווח על בעיית גודל התגובה; חזרה על אותה בקשה תיכשל שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务响应超出传输限制。请复制诊断信息并报告响应大小问题；重复相同请求仍会失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務回應超出傳輸限制。請複製診斷資訊並報告回應大小問題；重複相同請求仍會失敗。"
          }
        }
      }
    },
    "The service returned an unreadable backup.": {
