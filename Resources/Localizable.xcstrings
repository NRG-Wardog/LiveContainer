    "Retry once. If it repeats, check the connection and try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry once. If it repeats, check the connection and try again later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לנסות שוב פעם אחת. אם הכשל חוזר, יש לבדוק את החיבור ולנסות שוב מאוחר יותר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试一次。如果再次失败，请检查连接并稍后再试。"
