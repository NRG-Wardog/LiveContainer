    "lc.settings.bundleIdMismatch %@ %@": {
      "comment": "lc.settings.bundleIdMismatch",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرف الحُزْمَة لـ LiveContainer \"%@\" لا يتوافق مع معرف التطبيق في مستحقاته، يرى تطبيق LiveContainer إن معرف الحُزْمَة هو \"%@\". بعض وظائف التطبيق قد تكون غير متاحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bundle-ID von LiveContainer \"%@\" entspricht nicht dem Application-Identifier in den Entitlements, der \"%@\" als Bundle-ID erwartet. Einige Funktionen sind möglicherweise nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer's bundle ID, \"%@\", does not match application-Identifier in entitlements, which expects the bundle ID to be \"%@\". Some functions may not be available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de paquete de LiveContainer, \"%@\", no coincide con el identificador de la aplicación en los derechos, que espera que el ID de paquete sea \"%@\". Es posible que algunas funciones no estén disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID du bundle de LiveContainer, \"%@\", ne correspond pas à l'identificateur d'application dans les droits qui attendent que l'ID du bundle soit \"%@\". Certaines fonctions peuvent ne pas être disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID bundle di LiveContainer, \"%@\", non corrisponde all'application-identifier nei privilegi, che si aspetta l'ID bundle \"%@\". Alcune funzioni potrebbero non essere disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainerのバンドルID\"%@\"が、権限設定で指定されているアプリ識別子\"%@\"と一致していません。一部の機能が正しく動作しない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer 번들 ID \"%@\"(이)가 권한 내 앱 식별자인 번들 ID \"%@\"(과)와 동일하지 않습니다. 일부 기능이 작동하지 않을 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikator Pakietu LiveContainer \"%@\", nie jest zgodny z identyfikatorem aplikacji w upoważnieniach, które oczekują, aby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ID do pacote do LiveContainer, \"%@\", não corresponde ao Identificador de aplicações em legitimidade, que espera que o ID do pacote seja \"%@\". Algumas funções podem não estar disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИД пакета LiveContainer'а, \"%@\", не совпадает с entitlement \"application-Identifier\", который должен был иметь ожидаемое значение \"%@\". Некоторые функции могут быть ограничены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainers bundle ID, \"%@\", matchar inte program-Identifierare i entitlements, som förväntar sig att bundle ID ska vara \"%@\". Vissa funktioner kanske inte är tillgängliga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer'ın paket kimliği, “%@”, yetkilendirmelerde uygulama tanımlayıcısının beklediği “%@” ile eşleşmiyor. Bu nedenle bazı işlevler kullanılamayabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định danh gói LiveContainer, \"%@\", không trùng với application-Identifier trong entitlements, vốn yêu cầu định danh gói là \"%@\". Một số chức năng có thể không có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer的包名，“%@”与权限中application-identifier期望的包名“%@”不符。一些功能可能无法正常使用使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer 的套裝識別碼「%@」與權限中的 application-Identifier 不匹配，權限預期的套裝識別碼為「%@」。某些功能可能無法使用。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזהה החבילה של LiveContainer, \"%@\", אינו תואם לערך application-Identifier בקובץ ההרשאות, שבו מזהה החבילה הצפוי הוא \"%@\". ייתכן שחלק מהתכונות לא יהיו זמינות."
          }
        }
      }
    },
