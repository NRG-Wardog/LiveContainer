    "lc.appBanner.waitForJitMsg": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء استخدام طريقتك المفضله لتفعيل JIT لـLiveContainer الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
