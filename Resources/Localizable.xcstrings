    "Starts one manual refresh and shows scheduler state through verified completion or failure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts one manual refresh and shows scheduler state through verified completion or failure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחיל רענון ידני אחד ומציג את מצב המתזמן עד להשלמה מאומתת או לכשל."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始一次手动刷新，并显示调度器状态，直至经验证的完成或失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始一次手動重新整理，並顯示排程器狀態，直至經驗證的完成或失敗。"
          }
        }
      }
    },
