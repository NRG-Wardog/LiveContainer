    "lc.settings.multiLC.teamIdMismatch": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 مُوقع بشهادة أخرى عن LiveContainer, لذلك لن يعمل. الرجاء تثبيت LiveContainer2 بِنفس الحساب الذي استخدمته لتثبيت LiveContainer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 ist mit einem anderen Zertifikat signiert als LiveContainer, daher wird es nicht funktionieren. Bitte installieren Sie LiveContainer2 mit demselben Account, den Sie für die Installation von LiveContainer verwendet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 is signed with a different certificate from LiveContainer, so it will not work. Please install LiveContainer2 with the same account you used to install LiveContainer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 está firmado con un certificado distinto al de LiveContainer, por lo que no funcionará. Instala LiveContainer2 con la misma cuenta que usaste para instalar LiveContainer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 est signé avec un certificat différent de LiveContainer, donc il ne fonctionnera pas. Veuillez installer LiveContainer2 avec le même compte que celui utilisé pour installer LiveContainer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 è firmato con un certificato diverso da LiveContainer, quindi non funzionerà. Si prega di installare LiveContainer2 con lo stesso account usato per installare LiveContainer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer 2はLiveContainerと異なる証明書で署名されているため、動作しません。LiveContainerをインストールしたのと同じアカウントでLiveContainer 2をインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서가 일치하지 않습니다. LiveContainer 설치할 때 사용한 동일한 계정으로 LiveContainer2를 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 jest podpisany innym certyfikatem niż LiveContainer, więc nie będzie działać. Proszę, zainstalować LiveContainer2 używając tego samego konta, którego użyto przy instalacji LiveContainer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner secundário está assinado com um certificado diferente do contêiner primário, então não funcionará. Por favor, instale o contêiner secundário com o mesmo certificado usado para assinar o contêiner primário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второй LiveContainer подписан сертификатом, отличным от использованного с основным LiveContainer; он не будет работать. Переустановите второй LiveContainer с тем же аккаунтом, который вы использовали для подписи первого."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 är signerad med ett annat certifikat än LiveContainer, så det fungerar inte. Installera LiveContainer2 med samma konto du använde för att installera LiveContainer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2, LiveContainer'dan farklı bir sertifika ile imzalanmıştır, bu nedenle çalışmayacaktır. Lütfen LiveContainer2'yi LiveContainer'ı yüklemek için kullandığınız aynı hesapla yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 đã được cài với chứng chỉ khác so với LiveContainer, nên sẽ không dùng được. Vui lòng cài LiveContainer2 với cùng tài khoản bạn đã dùng để cài LiveContainer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名LiveContainer2和LiveContainer所使用的证书不一致，LiveContainer2无法正常工作。请使用签名LiveContainer的账户安装LiveContainer2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2使用與LiveContainer不同的證書簽名，因此它將無法工作。 請使用您用於安裝LiveContainer的同一帳戶安裝LiveContainer2。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer2 חתום בתעודת חתימה שונה מזו של LiveContainer, ולכן לא יפעל. יש להתקין את LiveContainer2 באמצעות אותו חשבון ששימש להתקנת LiveContainer."
          }
        }
      }
    },
    "lc.settings.multiLCDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بتثبيت عده LiveContainers، وتحويل عده تطبيقات الى تطبيقات مُشارَكه، يمكنك فتح تطبيق واحد بين جميع LiveContainers مع جميع ملفاتها وبياناتها وأعداداتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Installation mehrerer LiveContainer und die Konvertierung von Apps in geteilte Apps können Sie eine App in allen LiveContainern mit den meisten ihrer Daten und Einstellungen öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By installing multiple LiveContainers, and converting apps to Shared Apps, you can open one app between all LiveContainers with most of its data and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalando múltiples LiveContainers y convirtiendo las apps en Apps Compartidas, puedes abrir una app entre todos los LiveContainers conservando la mayoría de sus datos y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En installant plusieurs LiveContainers et en convertissant les applications en apps partagées, vous pouvez ouvrir une application entre tous les LiveContainers avec la plupart de ses données et paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installando più LiveContainer e convertendo app in applicazioni condivise, è possibile aprire un'app tra tutti i LiveContainers con la maggior parte dei suoi dati e impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のLiveContainerをインストールし、アプリを共有アプリに変換することで、ほとんどのデータや設定を保持したまま、すべてのLiveContainer間で1つのアプリを開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer를 여러 개 설치할 경우, 앱 여러 개를 동시에 실행할 수 있습니다. (설치한 앱은 공유된 앱으로 변환해야 합니다.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalując wiele LiveContainer’ów i zmieniając aplikacje w Aplikacje Współdzielonych, możesz otworzyć jedną aplikację między wszystkimi LiveContainer’ami, nie tracąc żadnych ustawień czy danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao instalar múltiplos contêineres, e converter os aplicativos em Aplicativos Compartilhados, você consegue abrir um aplicativo entre todos os contêineres com a maioria de seus dados e configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установив несколько LiveContainer'ов, вы сможете открывать приложения, преобразованные в общие, на всех LiveContainer'ах с сохранением большинства данных и настроек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att installera flera LiveContainers och konvertera appar till delade appar kan du öppna en app mellan alla LiveContainers med de flesta av dess data och inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla LiveContainer kurup uygulamaları Paylaşılan Uygulamalar’a dönüştürerek; paylaştığınız uygulamaları tüm LiveContainer’larda, uygulama ayarları ve verileriyle birlikte kullanabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng cách cài đặt nhiều LiveContainer và chuyển đổi app thành App được Chia sẻ, bạn có thể mở app giữa tất cả các LiveContainer với hầu hết dữ liệu và cài đặt của app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过安装多个LiveContainer并将App转换为共享App，你可以在这些LiveContainer之间打开同一个App，并保留其大部分数据和设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝多個 LiveContainer 並將應用程式轉換為共享應用程式後，就能在各個 LiveContainer 中開啟同一個應用程式，並保留大部分資料和設定。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באמצעות התקנת כמה מופעי LiveContainer והפיכת יישומים למשותפים, אפשר לפתוח את אותו יישום בכל אחד מהמופעים, עם רוב הנתונים וההגדרות שלו."
          }
        }
      }
    },
