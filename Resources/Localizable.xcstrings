    "The embedded automatic refresh bridge requires iOS 17 or later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded automatic refresh bridge requires iOS 17 or later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גשר הרענון האוטומטי המוטמע דורש iOS 17 ואילך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内嵌自动刷新桥接需要 iOS 17 或更新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內嵌自動重新整理橋接需要 iOS 17 或更新版本。"
          }
        }
      }
    },
    "The exact Anisette synchronization cause could not be safely identified. Check the configured server and copy Diagnostics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact Anisette synchronization cause could not be safely identified. Check the configured server and copy Diagnostics."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לזהות בבטחה את הסיבה המדויקת לבעיה בסנכרון Anisette. יש לבדוק את השרת שהוגדר ולהעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法可靠地确定 Anisette 同步问题的具体原因。请检查配置的服务器并复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法可靠地確定 Anisette 同步問題的具體原因。請檢查設定的伺服器並複製診斷資訊。"
          }
        }
      }
    },
    "The exact cause or retry safety could not be confirmed. Starting again creates a new attempt and may not resolve the previous failure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact cause or retry safety could not be confirmed. Starting again creates a new attempt and may not resolve the previous failure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר את הסיבה המדויקת או אם ניסיון חוזר בטוח. התחלה מחדש יוצרת ניסיון חדש ועשויה שלא לפתור את הכשל הקודם."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认具体原因，也无法确认重试是否安全。重新开始会创建新的尝试，可能无法解决上一次失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認具體原因，也無法確認重試是否安全。重新開始會建立新的嘗試，可能無法解決上一次失敗。"
          }
        }
      }
    },
    "The exact underlying cause was not safely identified. Copy Diagnostics before trying this action again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact underlying cause was not safely identified. Copy Diagnostics before trying this action again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיבה המדויקת שבבסיס הבעיה לא זוהתה בבטחה. יש להעתיק את פרטי האבחון לפני ניסיון נוסף לבצע פעולה זו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未可靠地确定具体根本原因。请先复制诊断信息，再尝试此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未可靠地確定具體根本原因。請先複製診斷資訊，再嘗試此操作。"
          }
        }
      }
    },
    "The guest could not be launched. The underlying cause is unknown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest could not be launched. The underlying cause is unknown."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להפעיל את היישום המתארח. הסיבה שבבסיס הבעיה אינה ידועה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动客体应用。根本原因未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動客體應用程式。根本原因未知。"
          }
        }
      }
    },
    "The guest exited before its launch completed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest exited before its launch completed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום המתארח יצא לפני שהפעלתו הושלמה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
