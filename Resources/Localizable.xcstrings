    "The service confirms this request was not dispatched. Clear the reservation only after reviewing it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service confirms this request was not dispatched. Clear the reservation only after reviewing it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות מאשר שבקשה זו לא נשלחה. יש לבטל את המקום שהוקצה לה רק לאחר בדיקתה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务确认此请求未发出。请先检查，再清除预留记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務確認此請求未發出。請先檢查，再清除預留記錄。"
          }
        }
      }
    },
    "The service could not determine whether retry is safe. Check the app and signing status before deciding to retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service could not determine whether retry is safe. Check the app and signing status before deciding to retry."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות לא הצליח לקבוע אם ניסיון חוזר בטוח. יש לבדוק את מצב היישום והחתימה לפני החלטה על ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务无法确定重试是否安全。请检查应用和签名状态，然后再决定是否重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務無法確定重試是否安全。請檢查應用程式和簽署狀態，然後再決定是否重試。"
          }
        }
      }
    },
    "The service could not verify the result. Check the account or device before clearing this hold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service could not verify the result. Check the account or device before clearing this hold."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות לא הצליח לאמת את התוצאה. יש לבדוק את החשבון או המכשיר לפני הסרת חסימה זו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务无法验证结果。请检查账户或设备，然后再解除此暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務無法驗證結果。請檢查帳號或裝置，然後再解除此暫停。"
          }
        }
      }
    },
    "The service did not observe the requested result. Check the account or device before clearing this hold.": {
      "extractionState": "manual",
