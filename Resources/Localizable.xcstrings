    "Apps already installed from this source stay installed, but they will no longer receive updates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps already installed from this source stay installed, but they will no longer receive updates."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שכבר הותקנו ממקור זה יישארו מותקנים, אך לא יקבלו עוד עדכונים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此源安装的应用将保留，但将不再接收更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此來源安裝的應用程式將保留，但將不再接收更新。"
          }
        }
      }
    },
    "Apps and Data": {
      "extractionState": "manual",
