    "You can retry; if it keeps failing, check the connection and try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can retry; if it keeps failing, check the connection and try again later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנסות שוב; אם הכשל נמשך, יש לבדוק את החיבור ולנסות שוב מאוחר יותר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以重试；如果仍然失败，请检查连接并稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以重試；如果仍然失敗，請檢查連線並稍後再試。"
          }
        }
      }
    },
