          }
        }
      }
    },
    "The configured anisette server is outdated, which increases the risk of locking the account. Continue anyway?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configured anisette server is outdated, which increases the risk of locking the account. Continue anyway?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת anisette שהוגדר מיושן, דבר שמגדיל את הסיכון לנעילת החשבון. להמשיך בכל זאת?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置的 anisette 服务器已过时，这会增加账户被锁定的风险。仍要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定的 anisette 伺服器已過時，這會增加帳號遭鎖定的風險。仍要繼續嗎？"
          }
        }
      }
