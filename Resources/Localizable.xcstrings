    "No free LiveContainer is available. Please either: \n(1)close one, \n(2)install a new one, \n(3)choose another method to enable JIT.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No free LiveContainer is available. Please either: \n(1)close one, \n(2)install a new one, \n(3)choose another method to enable JIT."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מופע LiveContainer פנוי. יש לבחור באחת האפשרויות: \n(1) לסגור מופע, \n(2) להתקין מופע חדש, \n(3) לבחור שיטה אחרת להפעלת JIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有空闲的 LiveContainer。请选择以下操作之一： \n(1)关闭一个， \n(2)安装新的一个， \n(3)选择其他方式启用 JIT。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有空閒的 LiveContainer。請選取以下操作之一： \n(1)關閉一個， \n(2)安裝新的一個， \n(3)選取其他方式啟用 JIT。"
          }
        }
      }
    },
