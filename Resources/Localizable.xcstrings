    "Apple ID is signed in, but SideStore could not confirm the current verification or provisioning response. Cancel the unconfirmed session before starting another attempt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID is signed in, but SideStore could not confirm the current verification or provisioning response. Cancel the unconfirmed session before starting another attempt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון מחובר ל-Apple ID, אך SideStore לא הצליח לאשר את תגובת האימות או הכנת המכשיר הנוכחית. יש לבטל את הסשן שלא אושר לפני התחלת ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID 已登录，但 SideStore 无法确认当前的验证或设备配置响应。请先取消未确认的会话，再开始新的尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID 已登入，但 SideStore 無法確認目前的驗證或裝置佈建回應。請先取消未確認的工作階段，再開始新的嘗試。"
          }
        }
      }
    },
    "Apple ID is signed in, but SideStore could not confirm the provisioning result. ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
