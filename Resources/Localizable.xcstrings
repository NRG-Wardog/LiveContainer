    "This guest container already has a window or a pending launch. Reopen it instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guest container already has a window or a pending launch. Reopen it instead."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למכל של יישום מתארח זה כבר יש חלון או הפעלה ממתינה. יש לפתוח אותו מחדש במקום זאת."
          }
        },
