    "Retry Provisioning could not be confirmed. Your last confirmed state is still signed in. Reload status, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry Provisioning could not be confirmed. Your last confirmed state is still signed in. Reload status, then try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר את הניסיון החוזר להכנת המכשיר. המצב האחרון שאושר עדיין מציג חשבון מחובר. יש לטעון מחדש את המצב ולנסות שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认设备配置重试。上次确认的状态仍为已登录。请重新加载状态后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認裝置佈建重試。上次確認的狀態仍為已登入。請重新載入狀態後再試。"
          }
        }
      }
    },
    "Retry Source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry Source"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
