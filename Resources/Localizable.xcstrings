        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבטל את נעילת ה-iPhone ולנסות לצאת שוב מהחשבון. אם הפעולה עדיין נכשלת, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁 iPhone 并再次尝试退出登录。如果仍失败，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請解鎖 iPhone 並再次嘗試登出。如果仍失敗，請複製診斷資訊。"
