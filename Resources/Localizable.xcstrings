    "%@ requests %lld permission(s):\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requests %lld permission(s):\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשת הרשאות מאת %@; מספר ההרשאות: %lld.\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求 %lld 项权限：\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
