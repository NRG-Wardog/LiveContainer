    "Retry will repeat the same failure. Check the app configuration before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry will repeat the same failure. Check the app configuration before trying again."
