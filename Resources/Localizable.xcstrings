    "This operation is not marked safe to retry. Check the app and signing status before running it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation is not marked safe to retry. Check the app and signing status before running it again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו אינה מסומנת כבטוחה לניסיון חוזר. יש לבדוק את מצב היישום והחתימה לפני ביצועה שוב."
