    "lc.appSettings.jit26.scriptDesc": {
      "comment": "lc.appSettings.jit26.scriptDesc",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تمرير ملف جافا سكريبت إلى StikDebug عند بدء تشغيل التطبيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine JavaScript-Datei an StikDebug übergeben, wenn JIT die App startet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An JavaScript file passed to StikDebug when JIT launching the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo JavaScript pasado a StikDebug cuando JIT inicia la aplicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier JavaScript a été transmis à StikDebug lors du lancement JIT de l'application"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file JavaScript passato a StikDebug quando attivando con JIT l'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをJITで起動する際にStikDebugに渡されたJavaScriptファイルを選択してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT을 활성화한 상태에서 앱을 실행하여 자바스크립트 파일이 StikDebug에게 전송되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik JavaScript został przekazany do StikDebug podczas uruchomienia aplikacji z JIT"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo JavaScript passou para StikDebug na inicialização JIT do app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл JavaScript, который будет передан StikDebug при запуске приложения с JIT"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama JIT ile başlatıldığında StikDebug'a aktarılan bir JavaScript dosyası"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp JavaScript được đưa qua StikDebug khi khởi động app với JIT"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在带JIT启动时传递给StikDebug的脚本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 JIT 啟動應用程式時，傳遞給 StikDebug 的 JavaScript 檔案。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ JavaScript שמועבר ל-StikDebug בעת הפעלת היישום עם JIT."
          }
        }
      }
    },
