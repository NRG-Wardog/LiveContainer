        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיטת ההתקנה אינה נתמכת. להגדרת תכונה זו יש להשתמש ב-AltStore או ב-SideStore."
          }
        }
      }
    },
    "lc.settings.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء عدم استعمال LiveContainer للقرصنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte benutzen Sie LiveContainer nicht für Raubkopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please don't use LiveContainer for piracy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, no uses LiveContainer para piratería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilisez pas LiveContainer pour le piratage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, non usare LiveContainer per la pirateria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainerを海賊版目的で使用しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer를 불법 복제 콘텐츠 공유 또는 사용 목적으로 이용하지 마십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosimy nie używać LiveContainer do piractwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, não use o LiveContainer para pirataria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пользуйтесь LiveContainer'ом для пиратства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänligen använd inte LiveContainer för piratkopiering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
