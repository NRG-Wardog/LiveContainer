    "lc.settings.multitaskDesc": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لك وضع المهام المتعددة بفتح تطبيقات متعددة في نفس الوقت. حوِّل تطبيقاتك لتطبيقات مشتركة لإستخدامهم في الوضع هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Multitasking-Modus können Sie mehrere Apps gleichzeitig öffnen. Wandeln Sie Ihre Apps in geteilte Apps um, damit sie in diesem Modus verwendet werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multitask Mode allows you to open multiple apps at the same time. Convert your apps to Shared Apps to use them in this mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo multitarea te permite abrir varias apps al mismo tiempo. Convierte tus apps en Apps Compartidas para usarlas en este modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode multitâche vous permet d'ouvrir plusieurs applications en même temps. Convertissez vos applications en applications partagées pour les utiliser dans ce mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità multitasking ti permette di aprire più app contemporaneamente. Converti le tue app in App Condivise per usarle in questa modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチタスクモードでは、複数のアプリを同時に開くことができます。使用するには、アプリを共有アプリに変換してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티태스킹 모드는 한 번에 여러 앱을 실행할 수 있도록 합니다. 해당 모드를 사용하기 위해선 각 앱을 공유된 앱으로 변환해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb wielozadaniowości pozwala na otwieranie wielu aplikacji w tym samym czasie. Aby korzystać z tego trybu, przekonwertuj swoje aplikacje na aplikacje dzielone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Modo de Multitarefa te permite abrir vários apps ao mesmo tempo. Converta seus apps em Apps Compartilhados para usá-los nesse modo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Многооконный режим позволяет вам открывать множество приложений одновременно. Конвертируйте свои приложения в общие для использования их в этом режиме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoklu Görev Modu, aynı anda birden fazla uygulamayı açmanıza olanak tanır. Uygulamalarınızı bu modda kullanmak için Paylaşılan Uygulamalar'a dönüştürün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ Đa nhiệm cho phép bạn mở nhiều app cùng lúc. Chuyển các app thành Được Chia sẻ để dùng chúng trong chế độ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过多任务模式你可以同时打开多个App。将App转换为共享App以在多任务模式中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多任務模式允許你同時使用多個應用程式。將應用程式轉換為共享應用程式以在多任務模式中使用。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב ריבוי משימות מאפשר לפתוח כמה יישומים בו-זמנית. כדי להשתמש בהם במצב זה, יש להפוך אותם ליישומים משותפים."
          }
        }
      }
    },
    "lc.settings.multitaskMode": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
