    "lc.appSettings.useLCBundleIdDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصحّح هذه الأخطاء باستخدام معرف الحزمه الخاص ب LiveContainer ويضعه فوق معرف الحزمة الخاص بالتطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebt diese Probleme durch die Verwendung der Bundle-Kennung von LiveContainer beim Überschreiben des Haupt-Bundles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes these issues by using LiveContainer’s bundle identifier when overwriting main bundle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige estos problemas usando el identificador de paquete de LiveContainer al sobrescribir el paquete principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige ces problèmes en utilisant l'identifiant du bundle de LiveContainer lors de l'écrasement du bundle principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema questi problemi usando il Bundle ID di LiveContainer quando sovrascrivi il bundle principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインバンドルを上書きするときにLiveContainerのバンドル識別子を使用することでこれらの問題を修正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메인 번들을 LiveContainer 번들 식별자로 덮어씌워서 문제를 해결합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawia te problemy przy użyciu identyfikatora pakietu LiveContainer podczas nadpisywania głównego pakietu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opção corrige estes erros usando o identificador do pacote do LiveContainer para substituir o pacote principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправляет некоторые проблемы использованием ИД пакета LiveContainer'а в ходе перезаписи основного пакета."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar dessa problem genom att använda LiveContainers bunt identifierare när du skriver över huvudbuntet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana paketi üzerine yazarken LiveContainer paket tanımlayıcısını kullanarak bu sorunları giderir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa các lỗi này bằng cách dùng định danh LiveContainer khi ghi đè gói chính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过使用LiveContainer的包名解决上述问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆寫主套件時使用 LiveContainer 的套件識別碼，以修復這些問題。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתקן בעיות אלה באמצעות שימוש במזהה החבילה של LiveContainer בעת החלפת החבילה הראשית."
          }
        }
      }
    },
