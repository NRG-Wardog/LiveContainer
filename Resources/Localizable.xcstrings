    "Reload app status to confirm the installed app and signing state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload app status to confirm the installed app and signing state."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את מצב היישומים כדי לאשר את היישום המותקן ואת מצב החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载应用状态，以确认已安装的应用和签名状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入應用程式狀態，以確認已安裝的應用程式和簽署狀態。"
          }
        }
      }
    },
    "Reload app status, then verify the installed app before starting another operation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload app status, then verify the installed app before starting another operation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את מצב היישומים ולבדוק את היישום המותקן לפני התחלת פעולה נוספת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载应用状态，然后验证已安装的应用，再开始其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入應用程式狀態，然後驗證已安裝的應用程式，再開始其他操作。"
          }
        }
      }
    },
    "Reload authoritative app status and expiration before taking another action. Completion may be uncertain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload authoritative app status and expiration before taking another action. Completion may be uncertain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את מצב היישומים הקובע ואת תאריכי התפוגה לפני פעולה נוספת. ייתכן שההשלמה אינה ודאית."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载权威应用状态和到期时间，然后再采取其他操作。操作是否完成可能尚不确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入作為判定依據的應用程式狀態和到期時間，然後再採取其他操作。操作是否完成可能尚不確定。"
          }
        }
      }
    },
    "Reload installed app status and verify the device before starting another mutation. Do not repeat this operation until its state is known.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload installed app status and verify the device before starting another mutation. Do not repeat this operation until its state is known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את מצב היישומים המותקנים ולבדוק את המכשיר לפני התחלת פעולה נוספת שמשנה נתונים. אין לחזור על פעולה זו עד שמצבה ידוע."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载已安装应用的状态并检查设备，然后再开始其他修改操作。在状态明确之前，请勿重复此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入已安裝應用程式的狀態並檢查裝置，然後再開始其他修改操作。在狀態明確之前，請勿重複此操作。"
          }
        }
      }
    },
    "Reload operation status before starting another mutation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload operation status before starting another mutation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את מצב הפעולה לפני התחלת פעולה נוספת שמשנה נתונים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载操作状态，然后再开始其他修改操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入操作狀態，然後再開始其他修改操作。"
          }
        }
      }
    },
    "Reload status before continuing. If SideStore still reports a signed-in account, try Sign Out again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload status before continuing. If SideStore still reports a signed-in account, try Sign Out again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את המצב לפני המשך הפעולה. אם SideStore עדיין מדווח על חשבון מחובר, יש לנסות לצאת שוב מהחשבון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载状态后再继续。如果 SideStore 仍报告账户已登录，请再次尝试退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入狀態後再繼續。如果 SideStore 仍報告帳號已登入，請再次嘗試登出。"
          }
        }
      }
    },
    "Reload status to check the current account state, then try Sign Out again if it remains signed in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload status to check the current account state, then try Sign Out again if it remains signed in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את המצב כדי לבדוק את מצב החשבון הנוכחי, ואז לנסות לצאת שוב אם הוא עדיין מחובר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载状态以检查当前账户状态；如果仍已登录，请再次尝试退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入狀態以檢查目前帳號狀態；如果仍已登入，請再次嘗試登出。"
          }
        }
      }
    },
    "Reload status, then sign in with the saved Apple ID to finish setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload status, then sign in with the saved Apple ID to finish setup."
          }
        },
        "he": {
