    "lc.settings.notDevCert": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer غير موقع بشهادة مطورين لذاLiveContainer لا يعمل على الإطلاق. الرجاء توقيع LiveContainer بشهادة التطويير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer ist nicht mit einem Entwicklungszertifikat signiert, daher wird LiveContainer nicht funktionieren. Bitte signiert Sie LiveContainer mit einem Entwicklungszertifikat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer is not signed with a development certificate so LiveContainer won't work at all. Please sign LiveContainer with a development certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer no está firmado con un certificado de desarrollo, por lo que no funcionará en absoluto. Firma LiveContainer con un certificado de desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer n'est pas signé avec un certificat de développement, donc LiveContainer ne fonctionnera pas du tout. Veuillez signer LiveContainer avec un certificat de développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer non è firmato con un certificato development quindi LiveContainer non funzionerà. Firma LiveContainer con un certificato development."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainerは開発用の証明書で署名されていないため、動作しません。有効な開発用証明書で署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer를 사용할 수 없습니다. 개발용 인증서로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer nie jest podpisany certyfikatem deweloperskim, więc w ogóle nie będzie działać. Proszę podpisać certyfikatem deweloperskim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LiveContainer não está assinado com um certificado de desenvolvimento, então o LiveContainer não irá funcionar. Por favor, assine o LiveContainer com um certificado de desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer не был подписан с сертификатом разработчика; LiveContainer не сможет работать. Пожалуйста, переподпишите его с действительным сертификатом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer, geliştirme sertifikası ile imzalanmadığından çalışmayacaktır. Lütfen LiveContainer'ı geliştirme sertifikası ile imzalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer không được ký với chứng chỉ phát triển nên LiveContainer không thể hoạt động. Vui lòng ký lại LiveContainer với chứng chỉ phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer未被使用开发证书签名，因此无法正常工作。请使用开发证书签名LiveContainer。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer未使用開發證書簽名，因此無法正常運作。請使用開發證書簽名LiveContainer。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer אינו חתום בתעודת פיתוח ולכן לא יפעל כלל. יש לחתום על LiveContainer באמצעות תעודת פיתוח."
          }
        }
      }
    },
