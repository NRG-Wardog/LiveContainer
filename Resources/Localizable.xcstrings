    "This installation has missing or ambiguous background task identifiers. Reinstall a corrected build; manual refresh remains available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This installation has missing or ambiguous background task identifiers. Reinstall a corrected build; manual refresh remains available."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהתקנה זו חסרים מזהי משימות רקע או שהם אינם חד-משמעיים. יש להתקין מחדש גרסת בנייה מתוקנת; רענון ידני נשאר זמין."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此安装中的后台任务标识符缺失或不明确。请重新安装修正后的构建版本；仍可手动刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
