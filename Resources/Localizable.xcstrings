    "Copy Diagnostics and report that the service could not encode its response. Repeating the same request will not help.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Diagnostics and report that the service could not encode its response. Repeating the same request will not help."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להעתיק את פרטי האבחון ולדווח שהשירות לא הצליח לקודד את התגובה שלו. חזרה על אותה בקשה לא תעזור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请复制诊断信息并报告服务无法编码响应。重复相同请求无济于事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請複製診斷資訊並報告服務無法編碼回應。重複相同請求無濟於事。"
          }
        }
      }
    },
    "Copy Diagnostics and report that the service reply exceeded the transfer limit. Repeating the same request will fail again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Diagnostics and report that the service reply exceeded the transfer limit. Repeating the same request will fail again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להעתיק את פרטי האבחון ולדווח שתגובת השירות חרגה ממגבלת ההעברה. חזרה על אותה בקשה תיכשל שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请复制诊断信息并报告服务响应超出传输限制。重复相同请求仍会失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請複製診斷資訊並報告服務回應超出傳輸限制。重複相同請求仍會失敗。"
          }
        }
      }
    },
    "Copy Diagnostics and report the service reply-encoding failure. Repeating the same request will not fix it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Diagnostics and report the service reply-encoding failure. Repeating the same request will not fix it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להעתיק את פרטי האבחון ולדווח על כשל בקידוד תגובת השירות. חזרה על אותה בקשה לא תתקן זאת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请复制诊断信息并报告服务响应编码失败。重复相同请求无法修复此问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請複製診斷資訊並報告服務回應編碼失敗。重複相同請求無法修復此問題。"
          }
        }
      }
    },
    "Copy Diagnostics, including the failed request step and server code. The correct recovery action is not yet known.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Diagnostics, including the failed request step and server code. The correct recovery action is not yet known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להעתיק את פרטי האבחון, כולל שלב הבקשה שנכשל וקוד השרת. פעולת השחזור המתאימה עדיין אינה ידועה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请复制诊断信息，包括失败的请求步骤和服务器代码。目前尚不清楚正确的恢复操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請複製診斷資訊，包括失敗的請求步驟和伺服器代碼。目前尚不清楚正確的恢復操作。"
          }
        }
      }
    },
