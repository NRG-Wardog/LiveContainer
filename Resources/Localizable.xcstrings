    "lc.settings.invalidCertError": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ في التأكيد من صحة هذه الشهادة. الرجاء التأكد من صحة الرمز السري و أذا الشهادة الذي تم اختيارها هي نفسها الذي استخدمت لتوقيع LiveContainer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat konnte nicht validiert werden. Bitte überprüfen Sie das Passwort und ob das ausgewählte Zertifikat zum Signieren von LiveContainer verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to validate certificate. Please check the password and verify the selected certificate is used to sign LiveContainer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al validar el certificado. Comprueba la contraseña y verifica que el certificado seleccionado se usa para firmar LiveContainer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la validation du certificat. Veuillez vérifier le mot de passe et si le certificat sélectionné est utilisé pour signer LiveContainer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convalidare il certificato. Controlla la password e se il certificato selezionato è utilizzato per firmare LiveContainer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書の検証に失敗しました。パスワードを確認して、選択した証明書がLiveContainerの署名に使用されているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서을 확인할 수 없습니다. LiveContainer를 서명하는데 사용한 인증서와 동일한지, 인증서 비밀번호가 올바른지 확인해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uprawomocnić certyfikatu. Proszę, sprawdź, czy hasło jest zgodne z certyfikatem użytym do podpisania LiveContainer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao validar certificado. Por favor, verifique a senha e se o devido certificado está sendo usando para assinar o LiveContainer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить сертификат. Пожалуйста, проверьте его пароль и убедитесь, что именно он был использован при подписи LiveContainer'а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att validera certifikatet. Kontrollera lösenordet och om det valda certifikatet används för att signera LiveContainer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika doğrulanamadı. Lütfen şifreyi kontrol edin ve seçilen sertifikanın LiveContainer'ı imzalamak için kullanılıp kullanılmadığını kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác thực chứng chỉ. Vui lòng kiểm tra mật khẩu và có phải là chứng chỉ này được dùng để ký LiveContainer không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证证书失败，请检查密码并确认该证书是签名LiveContainer所使用的证书"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證憑證。請檢查密碼，並確認所選憑證是用來簽署 LiveContainer 的憑證。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימות תעודת החתימה נכשל. יש לבדוק את הסיסמה ולוודא שהתעודה שנבחרה היא זו ששימשה לחתימה על LiveContainer."
          }
        }
      }
    },
