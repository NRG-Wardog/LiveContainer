            "value": "返回 LiveContainer"
          }
        }
      }
    },
    "Return to Refresh and start a new refresh. This stale request did not reach SideStore or the device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Refresh and start a new refresh. This stale request did not reach SideStore or the device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'רענון' ולהתחיל רענון חדש. בקשה מיושנת זו לא הגיעה ל-SideStore או למכשיר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回“刷新”并开始新的刷新。此过期请求未到达 SideStore 或设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請返回「重新整理」並開始新的重新整理。此過期請求未到達 SideStore 或裝置。"
          }
        }
      }
    },
    "Return to Sources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרה למקורות"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回“源”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回「來源」"
          }
        }
      }
    },
    "Return to Sources and reload the list. Confirm whether the source is present before submitting another add; copy Diagnostics if its status remains unclear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources and reload the list. Confirm whether the source is present before submitting another add; copy Diagnostics if its status remains unclear."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'מקורות' ולטעון מחדש את הרשימה. יש לוודא אם המקור קיים לפני שליחת בקשת הוספה נוספת; אם מצבו נותר לא ברור, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回“源”并重新加载列表。再次提交添加请求前，请确认源是否存在；如果状态仍不明确，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請返回「來源」並重新載入清單。再次提交新增請求前，請確認來源是否存在；如果狀態仍不明確，請複製診斷資訊。"
          }
        }
      }
    },
    "Return to Sources and reload the source list, then open the source again if it is still present.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources and reload the source list, then open the source again if it is still present."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'מקורות', לטעון מחדש את רשימת המקורות ולפתוח שוב את המקור אם הוא עדיין קיים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回“源”并重新加载源列表；如果此源仍存在，请再次打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請返回「來源」並重新載入來源清單；如果此來源仍存在，請再次開啟。"
          }
        }
      }
    },
    "Return to Sources and reload the source list, then open the source again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources and reload the source list, then open the source again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'מקורות', לטעון מחדש את רשימת המקורות ולפתוח שוב את המקור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回“源”并重新加载源列表，然后再次打开此源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請返回「來源」並重新載入來源清單，然後再次開啟此來源。"
          }
        }
      }
    },
    "Return to Sources and reload the source list. Check whether it was added before retrying; copy Diagnostics if its status is still unclear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources and reload the source list. Check whether it was added before retrying; copy Diagnostics if its status is still unclear."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'מקורות' ולטעון מחדש את רשימת המקורות. יש לבדוק אם הוא נוסף לפני ניסיון נוסף; אם מצבו עדיין לא ברור, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回“源”并重新加载源列表。重试前请检查是否已添加；如果状态仍不明确，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請返回「來源」並重新載入來源清單。重試前請檢查是否已新增；如果狀態仍不明確，請複製診斷資訊。"
          }
        }
      }
    },
    "Return to Sources and review the source result. Copy Diagnostics before retrying if its status is unclear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources and review the source result. Copy Diagnostics before retrying if its status is unclear."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'מקורות' ולבדוק את תוצאת הבקשה למקור. אם מצבו אינו ברור, יש להעתיק את פרטי האבחון לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回“源”并查看源结果。如果状态不明确，请先复制诊断信息再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請返回「來源」並查看來源結果。如果狀態不明確，請先複製診斷資訊再重試。"
          }
        }
      }
    },
    "Return to Sources and use the existing source. Remove it only after confirming which entry is correct.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Sources and use the existing source. Remove it only after confirming which entry is correct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לחזור ל'מקורות' ולהשתמש במקור הקיים. יש להסיר אותו רק לאחר אימות איזו רשומה נכונה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
