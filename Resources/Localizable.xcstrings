    "lc.appSettings.launchWithJitDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يحاول LiveContainer بالحصول على JIT قبل ان يُشغل التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer wird vor dem Start der App versuchen, die JIT-Berechtigung zu erlangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer will try to acquire JIT permission before launching the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer intentará obtener permiso JIT antes de lanzar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer essaiera d'obtenir l'autorisation de JIT avant de lancer l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer proverà ad acquisire i permessi JIT prima di lanciare l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainerはアプリを起動する前にJIT権限の取得を試みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 실행 전 JIT 권한 접근을 시도합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer spróbuje dostać uprawnienia JIT przed uruchomieniem aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer tentará adquirir a permissão para obter a compilação 'JIT' antes de iniciar o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer попытается получить разрешение JIT перед запуском приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer kommer att försöka skaffa JIT-tillstånd innan appen startas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer, uygulamayı başlatmadan önce JIT iznini almaya çalışacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer sẽ thử nhận quyền JIT trước khi mở app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在启动App前LiveContainer会尝试获取JIT权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟動應用程式之前，LiveContainer將嘗試獲取JIT許可權。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer ינסה לקבל הרשאה ל-JIT לפני הפעלת היישום."
          }
        }
      }
    },
