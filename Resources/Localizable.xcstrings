        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple יצרה את תעודת החתימה, אך לא ניתן לאמת את העותק המקומי שלה לחתימה. יש לפתוח את 'תעודות חתימה' ולטעון מחדש לפני יצירת תעודה נוספת."
          }
