        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お好きな方法でLiveContainerのJITを有効化してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 LiveContainer에 JIT을 활성화해주세요."
