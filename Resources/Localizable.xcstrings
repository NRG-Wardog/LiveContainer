    "The app was removed from the device, but SideStore is still waiting for the delete callback to settle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was removed from the device, but SideStore is still waiting for the delete callback to settle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום הוסר מהמכשיר, אך SideStore עדיין ממתין לסיום הטיפול בהודעת השלמת המחיקה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已从设备中移除，但 SideStore 仍在等待删除回调完成处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式已從裝置中移除，但 SideStore 仍在等待刪除回呼完成處理。"
          }
        }
      }
    },
    "The app you tried to install is encrypted. Please provide decrypted app.": {
