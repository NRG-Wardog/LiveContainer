    },
    "This build's secure storage group could not be identified. Reinstall or re-sign the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build's secure storage group could not be identified. Reinstall or re-sign the app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לזהות את קבוצת האחסון המאובטח של גרסת בנייה זו. יש להתקין את היישום מחדש או לחתום עליו מחדש."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别此构建版本的安全存储群组。请重新安装或重新签名应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別此建置版本的安全儲存群組。請重新安裝或重新簽署應用程式。"
          }
        }
      }
    },
    "This build's secure storage group is not available to every part of the app, so the response could not be delivered. Re-sign the app so its extensions share the secure group.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build's secure storage group is not available to every part of the app, so the response could not be delivered. Re-sign the app so its extensions share the secure group."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבוצת האחסון המאובטח של גרסת בנייה זו אינה זמינה לכל חלקי היישום, ולכן לא ניתן למסור את התגובה. יש לחתום על היישום מחדש כך שההרחבות שלו ישתפו את הקבוצה המאובטחת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建版本的安全存储群组并非对应用的所有部分均可用，因此无法递送响应。请重新签名应用，使其扩展共享同一个安全群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此建置版本的安全儲存群組並非對應用程式的所有部分均可用，因此無法遞送回應。請重新簽署應用程式，使其延伸功能共享同一個安全群組。"
          }
        }
      }
    },
    "This combined refresh bridge requires iOS 17 or later. Refresh was not started. Review app expiration and account status; copy these diagnostics if you need assistance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combined refresh bridge requires iOS 17 or later. Refresh was not started. Review app expiration and account status; copy these diagnostics if you need assistance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גשר הרענון המשולב דורש iOS 17 ואילך. הרענון לא התחיל. יש לבדוק את תוקף היישומים ואת מצב החשבון; לקבלת עזרה, אפשר להעתיק את פרטי האבחון האלה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此合并刷新桥接需要 iOS 17 或更新版本。刷新未开始。请检查应用到期时间和账户状态；如需帮助，请复制这些诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此合併重新整理橋接需要 iOS 17 或更新版本。重新整理未開始。請檢查應用程式到期時間和帳號狀態；如需幫助，請複製這些診斷資訊。"
          }
        }
      }
    },
    "This deletes history entries only. Refresh settings and the current signing status are not changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes history entries only. Refresh settings and the current signing status are not changed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת רשומות היסטוריה בלבד. הגדרות הרענון ומצב החתימה הנוכחי אינם משתנים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会删除历史记录条目。刷新设置和当前签名状态不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會刪除歷史記錄條目。重新整理設定和目前簽署狀態不會更改。"
          }
        }
      }
    },
    "This failure is not marked safe to retry. Resolve the displayed prerequisite and review Diagnostics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This failure is not marked safe to retry. Resolve the displayed prerequisite and review Diagnostics."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשל זה אינו מסומן כבטוח לניסיון חוזר. יש למלא את דרישת הקדם המוצגת ולעיין באבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此失败未标记为可安全重试。请满足显示的前提条件并查看诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此失敗未標記為可安全重試。請滿足顯示的前提條件並查看診斷資訊。"
          }
        }
      }
    },
    "This failure is not marked safe to retry. Review Diagnostics before another attempt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This failure is not marked safe to retry. Review Diagnostics before another attempt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשל זה אינו מסומן כבטוח לניסיון חוזר. יש לעיין באבחון לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此失败未标记为可安全重试。请先查看诊断信息，再尝试。"
          }
        },
        "zh-Hant": {
