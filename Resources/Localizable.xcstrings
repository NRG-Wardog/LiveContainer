    "JITLess mode is required since iOS 26. Please set it up in settings. \nPlease go to LiveContainer settings -> tap \"Import Certificate from SideStore\" / \"Import Certificate\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JITLess mode is required since iOS 26. Please set it up in settings. \nPlease go to LiveContainer settings -> tap \"Import Certificate from SideStore\" / \"Import Certificate\""
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החל מ-iOS 26 נדרש מצב ללא JIT. יש להגדיר אותו בהגדרות. \nיש לעבור להגדרות LiveContainer וללחוץ על \"ייבוא תעודת חתימה מ-SideStore\" / \"ייבוא תעודת חתימה\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iOS 26 起需要使用 JITLess 模式。请在设置中进行配置。 \n请前往 LiveContainer 设置 -> 轻点“从 SideStore 导入证书” / “导入证书”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 iOS 26 起需要使用 JITLess 模式。請在設定中進行設定。 \n請前往 LiveContainer 設定 -> 輕點「從 SideStore 匯入憑證」 / 「匯入憑證」"
          }
        }
      }
    },
