    "lc.settings.importCertificateDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأستعمال وضع بدون-JIT دون AltStore/SideStore، عليك أستيراد الشهادة الذي تم توقيع LiveContainer بها، هل تود المتابعة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie den JITLess-Modus ohne AltStore/SideStore nutzen möchten, müssen Sie das Zertifikat importieren, mit dem LiveContainer signiert wurde. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use JITLess mode without AltStore/SideStore, you have to import the certificate used to sign LiveContainer. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar el modo JITLess sin AltStore/SideStore, debes importar el certificado usado para firmar LiveContainer. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser le mode sans JIT sans AltStore/SideStore, vous devez importer le certificat utilisé pour signer LiveContainer. Poursuivre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare la modalità JITLess senza AltStore/SideStore, devi importare il certificato utilizzato per firmare LiveContainer. Vuoi Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore/SideStoreなしでJITレスモードを使用するには、LiveContainerに署名するための証明書をインポートする必要があります。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore, SideStore 없이 JIT-Less 모드를 사용하려면, LiveContainer를 설치할 때 사용한 동일한 인증서가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać trybu JIT-Less bez AltStore czy SideStore, trzeba zaimportować certyfikat użyty do podpisania LiveContainer. Czy chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o modo JIT-Less sem a AltStore/SideStore, você deve importar, especificamente, o certificado usado para assinar o LiveContainer. Deseja continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы включить режим JIT-less без AltStore/SideStore, вам потребуется указать сертификат, которым вы подписали LiveContainer. Продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att använda JITLess utan AltStore/SideStore måste du importera certifikatet som används för att signera LiveContainer. Vill du fortsätta?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore/SideStore olmadan JITLess modunu kullanmak için, LiveContainer'ı imzalamak için kullanılan sertifikayı içe aktarmanız gerekir. Devam etmek istiyor musunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng chức năng JITLess không cần AltStore/SideStore, bạn phải nhập chứng chỉ được dùng để ký LiveContainer. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要不通过SideStore/AltStore使用免JIT模式，你需要导入用于签名LiveContainer的证书。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若不透過SideStore/AltStore使用免JIT模式，你需要匯入用於簽署LiveContainer的證書。要繼續嗎？"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש במצב ללא JIT בלי AltStore או SideStore, יש לייבא את תעודת החתימה ששימשה לחתימה על LiveContainer. להמשיך?"
          }
        }
      }
    },
