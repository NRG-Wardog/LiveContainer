    "%@ contains %lld extension(s). Keep them using the main app's profile or register an App ID for each, or choose which to remove.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contains %lld extension(s). Keep them using the main app's profile or register an App ID for each, or choose which to remove."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%@ יש הרחבות, ומספרן %lld. ניתן להשאיר אותן באמצעות הפרופיל של היישום הראשי, לרשום App ID נפרד לכל הרחבה או לבחור אילו להסיר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 包含 %lld 个扩展。你可以使用主应用的描述文件保留它们，为每个扩展注册 App ID，或选择要移除的扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 包含 %lld 個延伸功能。你可以使用主應用程式的描述檔保留它們，為每個延伸功能註冊 App ID，或選取要移除的延伸功能。"
          }
        }
