          }
        }
      }
    },
    "Relaunch LiveContainer after reinstalling or re-signing it. Nothing was written to a private store, and the next launch can retry this run.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaunch LiveContainer after reinstalling or re-signing it. Nothing was written to a private store, and the next launch can retry this run."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל מחדש את LiveContainer לאחר התקנה מחדש או חתימה מחדש. דבר לא נכתב למאגר פרטי, ובהפעלה הבאה ניתן יהיה לנסות שוב הפעלה זו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装或重新签名后，请重新启动 LiveContainer。未向私有存储写入任何内容，下次启动时可以重试此次运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安裝或重新簽署後，請重新啟動 LiveContainer。未向私有儲存寫入任何內容，下次啟動時可以重試此次執行。"
          }
        }
      }
    },
    "Relaunch LiveContainer after reinstalling or re-signing. Manual Refresh All still works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaunch LiveContainer after reinstalling or re-signing. Manual Refresh All still works."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל מחדש את LiveContainer לאחר התקנה מחדש או חתימה מחדש. האפשרות הידנית 'רענון הכול' עדיין פועלת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装或重新签名后，请重新启动 LiveContainer。仍可手动执行“全部刷新”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安裝或重新簽署後，請重新啟動 LiveContainer。仍可手動執行「全部重新整理」。"
          }
        }
      }
    },
    "Reload Account & Signing before continuing. Keep the authenticated account and certificate; do not repeat Apple resource creation to repair local storage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Account & Signing before continuing. Keep the authenticated account and certificate; do not repeat Apple resource creation to repair local storage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את 'חשבון וחתימה' לפני המשך הפעולה. יש לשמור את החשבון המאומת ואת תעודת החתימה; אין ליצור שוב משאבים ב-Apple כדי לתקן אחסון מקומי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载“账户与签名”后再继续。保留已通过身份验证的账户和证书；不要通过重复创建 Apple 资源来修复本地存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入「帳號與簽署」後再繼續。保留已通過身分驗證的帳號和憑證；不要通過重複建立 Apple 資源來修復本地儲存。"
          }
        }
      }
    },
    "Reload Account & Signing to reconcile local storage before starting another sign-in. Keep existing account data and copy Diagnostics if this continues.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Account & Signing to reconcile local storage before starting another sign-in. Keep existing account data and copy Diagnostics if this continues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את 'חשבון וחתימה' כדי להתאים את מצב האחסון המקומי לפני ניסיון כניסה נוסף. יש לשמור את נתוני החשבון הקיימים ולהעתיק את פרטי האבחון אם הבעיה נמשכת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载“账户与签名”以核对本地存储，然后再开始新的登录。保留现有账户数据；如果问题持续，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入「帳號與簽署」以核對本地儲存，然後再開始新的登入。保留現有帳號資料；如果問題持續，請複製診斷資訊。"
          }
        }
      }
    },
    "Reload Account & Signing to reconcile which Apple account is active before continuing. Do not assume Sign Out completed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Account & Signing to reconcile which Apple account is active before continuing. Do not assume Sign Out completed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון מחדש את 'חשבון וחתימה' כדי לברר איזה חשבון Apple פעיל לפני המשך הפעולה. אין להניח שהיציאה מהחשבון הושלמה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载“账户与签名”，核对当前激活的是哪个 Apple 账户后再继续。不要假定退出登录已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入「帳號與簽署」，核對目前啟用的是哪個 Apple 帳號後再繼續。不要假定登出已完成。"
          }
        }
      }
    },
