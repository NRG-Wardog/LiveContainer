    "Open Sources and review the source request. Copy Diagnostics if the result remains unclear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sources and review the source request. Copy Diagnostics if the result remains unclear."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את 'מקורות' ולבדוק את הבקשה למקור. אם התוצאה נותרת לא ברורה, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
