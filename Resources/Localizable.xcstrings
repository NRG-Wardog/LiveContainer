    },
    "This pending certificate is ready for activation. Sign in again with the original Apple ID to finish signing setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pending certificate is ready for activation. Sign in again with the original Apple ID to finish signing setup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תעודת חתימה ממתינה זו מוכנה להפעלה. יש להיכנס שוב עם ה-Apple ID המקורי כדי להשלים את הגדרת החתימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
