          }
        }
      }
    },
    "Check the device before clearing this saved record. An earlier operation may still be running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the device before clearing this saved record. An earlier operation may still be running."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את המכשיר לפני מחיקת רשומה שמורה זו. ייתכן שפעולה קודמת עדיין מתבצעת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此已保存的记录前，请检查设备。之前的操作可能仍在进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此已儲存的記錄前，請檢查裝置。之前的操作可能仍在進行。"
          }
        }
      }
    },
    "Check the device before restarting SideStore?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the device before restarting SideStore?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבדוק את המכשיר לפני הפעלה מחדש של SideStore?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 SideStore 前检查设备？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動 SideStore 前檢查裝置？"
          }
        }
      }
    },
    "Check the device before starting another mutation. If no operation is running, use Reconcile After Checking Device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the device before starting another mutation. If no operation is running, use Reconcile After Checking Device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את המכשיר לפני התחלת פעולה נוספת שמשנה נתונים. אם אין פעולה שמתבצעת, יש להשתמש ב'התאמת המצב לאחר בדיקת המכשיר'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始另一次修改操作前，请检查设备。如果没有操作正在进行，请使用“检查设备后核对状态”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始另一次修改操作前，請檢查裝置。如果沒有操作正在進行，請使用「檢查裝置後核對狀態」。"
          }
        }
      }
    },
    "Check the device. If no operation is still running, use Reconcile After Checking Device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the device. If no operation is still running, use Reconcile After Checking Device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את המכשיר. אם אין פעולה שעדיין מתבצעת, יש להשתמש ב'התאמת המצב לאחר בדיקת המכשיר'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查设备。如果没有操作仍在进行，请使用“检查设备后核对状态”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查裝置。如果沒有操作仍在進行，請使用「檢查裝置後核對狀態」。"
          }
        }
      }
    },
    "Check the network connection and retry the source request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the network connection and retry the source request."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את החיבור לרשת ולנסות שוב את הבקשה למקור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接，然后重试源请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路連線，然後重試來源請求。"
          }
        }
      }
    },
    "Check the network used by this request, then retry when the connection is stable. If a device operation still fails, run Connection Check.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the network used by this request, then retry when the connection is stable. If a device operation still fails, run Connection Check."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את הרשת שבה משתמשת בקשה זו ולנסות שוב כשהחיבור יציב. אם פעולה במכשיר עדיין נכשלת, יש להריץ בדיקת חיבור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查此请求使用的网络，并在连接稳定后重试。如果设备操作仍失败，请运行“连接检查”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查此請求使用的網路，並在連線穩定後重試。如果裝置操作仍失敗，請執行「連線檢查」。"
          }
        }
      }
    },
    "Check the network, then retry from Sources. This error came from SideStore's known-source safety list, not the URL you entered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the network, then retry from Sources. This error came from SideStore's known-source safety list, not the URL you entered."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את הרשת ואז לנסות שוב מתוך 'מקורות'. השגיאה התקבלה מרשימת הבטיחות של המקורות המוכרים של SideStore, ולא מכתובת ה-URL שהוזנה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络，然后在“源”中重试。此错误来自 SideStore 的已知源安全列表，并非你输入的网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路，然後在「來源」中重試。此錯誤來自 SideStore 的已知來源安全清單，並非你輸入的網址。"
          }
        }
      }
    },
    "Check the original certificate request before creating or revoking certificates. Reconciliation does not submit another request or revoke a certificate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original certificate request before creating or revoking certificates. Reconciliation does not submit another request or revoke a certificate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את הבקשה המקורית לתעודת החתימה לפני יצירה או ביטול של תעודות. התאמת המצב אינה שולחת בקשה נוספת ואינה מבטלת תעודה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建或撤销证书前，请检查原始证书请求。核对状态不会提交其他请求，也不会撤销证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立或撤銷憑證前，請檢查原始憑證請求。核對狀態不會提交其他請求，也不會撤銷憑證。"
          }
        }
      }
    },
