    "The operation could not be confirmed as started. It may still be active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not be confirmed as started. It may still be active."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר שהפעולה התחילה. ייתכן שהיא עדיין פעילה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认操作已开始。该操作可能仍在进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認操作已開始。該操作可能仍在進行。"
          }
        }
      }
    },
    "The operation could not start because another SideStore operation is still active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not start because another SideStore operation is still active."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחיל את הפעולה מפני שפעולה אחרת של SideStore עדיין פעילה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 SideStore 操作仍在进行，因此无法开始此操作。"
