          }
        }
      }
    },
    "You can retry. If it keeps failing, keep the technical details and review Account and Signing and Certificates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can retry. If it keeps failing, keep the technical details and review Account and Signing and Certificates."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנסות שוב. אם הכשל נמשך, יש לשמור את הפרטים הטכניים ולעיין ב\"חשבון וחתימה\" וב\"תעודות חתימה\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以重试。如果仍然失败，请保留技术详细信息，并检查“账户与签名”和“证书”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以重試。如果仍然失敗，請保留技術詳細資訊，並檢查「帳號與簽署」和「憑證」。"
          }
        }
      }
    },
