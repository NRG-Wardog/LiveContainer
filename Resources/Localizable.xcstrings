    "The operation session is no longer available, so its device result cannot be confirmed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation session is no longer available, so its device result cannot be confirmed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן הפעולה אינו זמין עוד, ולכן לא ניתן לאשר את התוצאה שלו במכשיר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作会话已不可用，因此无法确认其设备端结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作工作階段已不可用，因此無法確認其裝置端結果。"
          }
        }
      }
    },
    "The operation was cancelled before it finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was cancelled before it finished."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה בוטלה לפני שהסתיימה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作在完成之前已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作在完成之前已取消。"
