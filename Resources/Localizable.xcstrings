          }
        }
      }
    },
    "The verification response could not be confirmed. The exact underlying cause could not be safely identified. Check the sign-in status before trying again.\nError ID: SS-AUTH-C11": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification response could not be confirmed. The exact underlying cause could not be safely identified. Check the sign-in status before trying again.\nError ID: SS-AUTH-C11"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר את תגובת האימות. לא ניתן לזהות בבטחה את הסיבה המדויקת שבבסיס הבעיה. יש לבדוק את מצב הכניסה לפני ניסיון נוסף.\nמזהה שגיאה: SS-AUTH-C11"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认验证响应。无法可靠地确定具体根本原因。请检查登录状态后再试。\n错误 ID：SS-AUTH-C11"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認驗證回應。無法可靠地確定具體根本原因。請檢查登入狀態後再試。\n錯誤 ID：SS-AUTH-C11"
          }
        }
      }
    },
    "The verification session expired. SideStore currently reports an account as signed in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification session expired. SideStore currently reports an account as signed in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף סשן האימות פג. SideStore מדווח כעת על חשבון מחובר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证会话已过期。SideStore 当前报告有账户已登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證工作階段已過期。SideStore 目前報告有帳號已登入。"
          }
        }
      }
    },
    "The verification session expired. SideStore reports authentication, but device provisioning is incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification session expired. SideStore reports authentication, but device provisioning is incomplete."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף סשן האימות פג. SideStore מדווח על אימות, אך הכנת המכשיר אינה שלמה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证会话已过期。SideStore 报告身份验证成功，但设备配置未完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證工作階段已過期。SideStore 報告身分驗證成功，但裝置佈建未完成。"
          }
        }
      }
    },
    "This action directly launches an app in normal mode in LiveContainer. To get the launch URL, open LiveContainer, hold the app, tap \"Add to Home Screen\" -> \"Copy Launch URL\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action directly launches an app in normal mode in LiveContainer. To get the launch URL, open LiveContainer, hold the app, tap \"Add to Home Screen\" -> \"Copy Launch URL\""
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מפעילה ישירות יישום במצב רגיל ב-LiveContainer. לקבלת כתובת ההפעלה, יש לפתוח את LiveContainer, ללחוץ לחיצה ממושכת על היישום ולהקיש על \"הוספה למסך הבית\" -> \"העתקת כתובת ההפעלה\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会直接在 LiveContainer 中以普通模式启动应用。要获取启动 URL，请打开 LiveContainer，长按应用，轻点“添加到主屏幕” -> “复制启动 URL”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會直接在 LiveContainer 中以普通模式啟動應用程式。要取得啟動 URL，請開啟 LiveContainer，長按應用程式，輕點「新增到主螢幕」 -> 「複製啟動 URL」"
          }
        }
      }
    },
    "This app is no longer in the library.": {
