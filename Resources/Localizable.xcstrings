      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app you tried to install is encrypted. Please provide decrypted app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום שניסית להתקין מוצפן. יש לספק יישום שההצפנה שלו הוסרה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尝试安装的应用已加密。请提供已解密的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘗試安裝的應用程式已加密。請提供已解密的應用程式。"
          }
        }
      }
    },
    "The app's source must be added before installation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's source must be added before installation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להוסיף את מקור היישום לפני ההתקנה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装前必须先添加此应用的源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝前必須先新增此應用程式的來源。"
          }
        }
      }
    },
    "The application container directories could not be prepared. Existing data was preserved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application container directories could not be prepared. Existing data was preserved."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להכין את תיקיות מכל היישום. הנתונים הקיימים נשמרו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备应用容器目录。现有数据已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備應用程式容器目錄。現有資料已保留。"
          }
        }
      }
    },
    "The backend confirmed it stopped. Retry if you still need to complete this action.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend confirmed it stopped. Retry if you still need to complete this action."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות אישר שהפסיק לפעול. אפשר לנסות שוב אם עדיין צריך להשלים פעולה זו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端已确认停止。如果仍需完成此操作，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後端已確認停止。如果仍需完成此操作，請重試。"
          }
        }
      }
    },
    "The backend confirmed it stopped. Retry when you are ready to run this action again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend confirmed it stopped. Retry when you are ready to run this action again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות אישר שהפסיק לפעול. אפשר לנסות שוב כשנוח לך לבצע פעולה זו מחדש."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端已确认停止。准备好再次执行此操作时，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後端已確認停止。準備好再次執行此操作時，請重試。"
          }
        }
      }
    },
    "The backend has not confirmed that the operation stopped. Do not retry yet; wait for status reconciliation and reload before starting another mutation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend has not confirmed that the operation stopped. Do not retry yet; wait for status reconciliation and reload before starting another mutation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות עדיין לא אישר שהפעולה הופסקה. אין לנסות שוב עדיין; יש להמתין להתאמת המצב ולטעון אותו מחדש לפני התחלת פעולה נוספת שמשנה נתונים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端尚未确认操作已停止。暂时不要重试；请等待状态核对并重新加载后，再开始其他修改操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後端尚未確認操作已停止。暫時不要重試；請等待狀態核對並重新載入後，再開始其他修改操作。"
          }
        }
      }
    },
    "The certificate is stored but could not be validated yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate is stored but could not be validated yet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תעודת החתימה מאוחסנת, אך עדיין לא ניתן לאמת אותה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书已保存，但尚无法验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證已儲存，但尚無法驗證。"
          }
        }
      }
    },
    "The certificate stored by LiveContainer is reported as revoked. Import a current copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate stored by LiveContainer is reported as revoked. Import a current copy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דווח שתעודת החתימה ששמורה ב-LiveContainer בוטלה. יש לייבא עותק עדכני."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer 保存的证书被报告为已撤销。请导入有效副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer 儲存的憑證被報告為已撤銷。請匯入有效副本。"
          }
        }
      }
    },
    "The combined app could not find its embedded LiveProcess extension. Confirm that the installed app is the combined LiveContainer + SideStore package; do not reset SideStore or guest data. Copy diagnostics if it continues.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combined app could not find its embedded LiveProcess extension. Confirm that the installed app is the combined LiveContainer + SideStore package; do not reset SideStore or guest data. Copy diagnostics if it continues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום המשולב לא הצליח למצוא את ההרחבה LiveProcess המוטמעת בו. יש לוודא שהיישום המותקן הוא החבילה המשולבת של LiveContainer + SideStore; אין לאפס את SideStore או את נתוני היישומים המתארחים. אם הבעיה נמשכת, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并应用找不到其内嵌的 LiveProcess 扩展。请确认已安装的应用是 LiveContainer + SideStore 合并程序包；不要重置 SideStore 或客体应用数据。如果问题持续，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併應用程式找不到其內嵌的 LiveProcess 延伸功能。請確認已安裝的應用程式是 LiveContainer + SideStore 合併套件；不要重設 SideStore 或客體應用程式資料。如果問題持續，請複製診斷資訊。"
          }
        }
      }
    },
