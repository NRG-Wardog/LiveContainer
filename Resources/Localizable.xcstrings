    "lc.settings.unsupportedInstallMethod": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة التثبيت غير مدعومة. الرجاء أستعمال AltStore أو SideStore لأعداد هذه الميزة."
          }
        },
        "de": {
