    },
    "Check available storage and access to LiveContainer's shared App Group container. Keep existing data intact and copy diagnostics if preparation still fails.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check available storage and access to LiveContainer's shared App Group container. Keep existing data intact and copy diagnostics if preparation still fails."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את שטח האחסון הזמין ואת הגישה למכל קבוצת היישומים המשותף של LiveContainer. יש לשמור על הנתונים הקיימים ללא שינוי ולהעתיק את פרטי האבחון אם ההכנה עדיין נכשלת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查可用存储空间，以及能否访问 LiveContainer 的共享 App 群组容器。请保留现有数据；如果准备工作仍失败，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查可用儲存空間，以及能否存取 LiveContainer 的共享 App 群組容器。請保留現有資料；如果準備工作仍失敗，請複製診斷資訊。"
          }
        }
      }
    },
    "Check installed host signing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check installed host signing"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקת חתימת היישום המארח המותקן"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已安装宿主应用的签名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查已安裝宿主應用程式的簽署"
          }
        }
      }
    },
    "Check its status or confirm on the device that the operation has stopped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check its status or confirm on the device that the operation has stopped."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את מצב הפעולה או לאמת במכשיר שהיא הופסקה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查其状态，或在设备上确认操作已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查其狀態，或在裝置上確認操作已停止。"
          }
        }
      }
    },
    "Check the configured Anisette server address, then sync again after correcting it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the configured Anisette server address, then sync again after correcting it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את כתובת שרת Anisette שהוגדרה ואז לסנכרן שוב לאחר תיקונה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查配置的 Anisette 服务器地址，修正后再次同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查設定的 Anisette 伺服器地址，修正後再次同步。"
          }
        }
      }
    },
    "Check the configured Anisette server and your network, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the configured Anisette server and your network, then try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את שרת Anisette שהוגדר ואת הרשת ולנסות שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
