    "Wait before retrying once. If the server is still rate-limiting requests, choose another configured Anisette server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait before retrying once. If the server is still rate-limiting requests, choose another configured Anisette server."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להמתין לפני ניסיון נוסף אחד. אם השרת עדיין מגביל את קצב הבקשות, יש לבחור שרת Anisette אחר שהוגדר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等后重试一次。如果服务器仍在限制请求频率，请选择其他已配置的 Anisette 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍等後重試一次。如果伺服器仍在限制請求頻率，請選取其他已設定的 Anisette 伺服器。"
          }
        }
      }
    },
