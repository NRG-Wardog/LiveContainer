        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 正忙於其他請求，因此未確認新增此來源。"
          }
        }
      }
    },
    "SideStore was busy with another request, so it did not start removing this source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
