        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę użyć Twojej preferowanej metody włączenia JIT dla obecnego LiveContainer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, use sua maneira favorita para habilitar JIT para o contêiner atual."
