          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 当前的签名证书被报告为已撤销。请打开“证书”，选择或创建有效证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 目前的簽署憑證被報告為已撤銷。請開啟「憑證」，選取或建立有效憑證。"
          }
