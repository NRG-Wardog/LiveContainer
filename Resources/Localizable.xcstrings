    "lc.settings.JitDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد سيرفر SideJITServer/JITStreamer. أذن الشبكة المحلية مطلوب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie Ihren JIT-aktiverer ein. Berechtigung für das lokale Netzwerk könnten erforderlich sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up your JIT enabler. Local Network permission may be required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura tu activador JIT. Puede requerirse el permiso de red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez votre activateur JIT. Une autorisation réseau locale peut être requise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il tuo abilitatore JIT. Potrebbe essere richiesto il permesso di rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JITを有効化するツールを設定してください。ローカルネットワークの許可が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 활성화 도구를 설정해보세요. 로컬 네트워크 권한이 요구될 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby skonfigurować program włączający JIT. Potrzebne będzie uprawnienie \"dostęp do sieci lokalnej\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o seu habilitador JIT. Permissão da Conexão Local é necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите свой включатель JIT. Может потребоваться разрешение на доступ к локальной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurera din JIT-möjliggörare. Lokala nätverkstillstånd kan krävas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT etkinleştiricinizi kurun. Yerel Ağ izni gerekebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập công cụ bật JIT. Có thể cần yêu cầu quyền Mạng Cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置JIT启用工具。可能需要本地网络权限。"
          }
        },
        "zh-Hant": {
