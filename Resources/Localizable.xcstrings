    },
    "Open Refresh Manager to inspect this run, then try Test Refresh again. Copy Diagnostics if the result remains unclear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Refresh Manager to inspect this run, then try Test Refresh again. Copy Diagnostics if the result remains unclear."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את מנהל הרענון ולבדוק הפעלה זו, ואז לנסות שוב רענון בדיקה. אם התוצאה נותרת לא ברורה, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“刷新管理器”查看此次运行，然后重试测试刷新。如果结果仍不明确，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「重新整理管理器」查看此次執行，然後重試測試重新整理。如果結果仍不明確，請複製診斷資訊。"
          }
        }
      }
    },
    "Open Refresh Manager to reconcile the run, then run Test Refresh again. Copy Diagnostics if the result remains missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Refresh Manager to reconcile the run, then run Test Refresh again. Copy Diagnostics if the result remains missing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את מנהל הרענון כדי להתאים את המצב להפעלה, ואז להריץ שוב רענון בדיקה. אם התוצאה עדיין חסרה, יש להעתיק את פרטי האבחון."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“刷新管理器”核对此次运行，然后重新执行测试刷新。如果仍缺少结果，请复制诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟「重新整理管理器」核對此次執行，然後重新執行測試重新整理。如果仍缺少結果，請複製診斷資訊。"
          }
        }
      }
    },
