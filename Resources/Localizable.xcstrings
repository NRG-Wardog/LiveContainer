    "lc.appSettings.classicMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Experimental) Compatibility Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（实验性）兼容模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（實驗性）相容模式"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "(ניסיוני) מצב תאימות"
          }
        }
      }
    },
    "lc.appSettings.classicModeDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Experimental) Guides the system to display the app at the appropriate resolution. On iPad OS, the app will be displayed in iPhone mode if it does not natively support iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "(ניסיוני) מנחה את המערכת להציג את היישום ברזולוציה המתאימה. ב-iPadOS, יישום שאינו תומך ב-iPad באופן מובנה יוצג במצב iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（实验性）引导系统以适当的分辨率显示应用。在 iPadOS 上，如果应用本身不支持 iPad，则会以 iPhone 模式显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（實驗性）引導系統以適當的解析度顯示應用程式。在 iPadOS 上，如果應用程式本身不支援 iPad，則會以 iPhone 模式顯示。"
          }
        }
      }
    },
