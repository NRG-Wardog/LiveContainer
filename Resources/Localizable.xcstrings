    "A host replacement is still pending. Reopen LiveContainer and check the installed profile before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A host replacement is still pending. Reopen LiveContainer and check the installed profile before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפת היישום המארח עדיין ממתינה להשלמה. יש לפתוח מחדש את LiveContainer ולבדוק את הפרופיל המותקן לפני ניסיון נוסף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宿主应用替换仍未完成。请重新打开 LiveContainer 并检查已安装的描述文件，然后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "宿主應用程式替換仍未完成。請重新開啟 LiveContainer 並檢查已安裝的描述檔，然後再試。"
          }
        }
      }
    },
    "A local account or certificate save could not be verified. Setup is blocked until that saved state is repaired; another sign-in cannot safely retry it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local account or certificate save could not be verified. Setup is blocked until that saved state is repaired; another sign-in cannot safely retry it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת שחשבון או תעודת חתימה נשמרו מקומית. ההגדרה חסומה עד לתיקון המצב השמור; כניסה נוספת לא יכולה לנסות זאת שוב בבטחה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证本地账户或证书是否已保存。在修复已保存的状态之前，设置已被阻止；再次登录无法安全地重试此步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證本機帳號或憑證是否已儲存。必須先修復已儲存的狀態，才能繼續設定；再次登入無法安全地重試此步驟。"
          }
        }
      }
    },
    "A network connection was unavailable during %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A network connection was unavailable during %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא היה חיבור לרשת במהלך %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行 %@ 时网络连接不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 %@ 時網路連線不可用。"
          }
        }
      }
    },
    "A pairing file is required before this device can be refreshed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pairing file is required before this device can be refreshed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש קובץ צימוד לפני שניתן לרענן מכשיר זה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须先提供配对文件，才能刷新此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先提供配對檔案，才能重新整理此裝置。"
          }
        }
      }
    },
    "A previous %@ has an unresolved result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous %@ has an unresolved result"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאת פעולה קודמת מסוג %@ עדיין לא הוכרעה"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次%@的结果尚未确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次%@的結果尚未確定"
          }
        }
      }
    },
    "A previous %@ may still be running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous %@ may still be running"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שפעולה קודמת מסוג %@ עדיין מתבצעת"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次%@可能仍在进行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次%@可能仍在進行"
          }
        }
      }
    },
    "A previous operation is unresolved. Use the recovery banner at the top of SideStore to resume its status check or reconcile after checking the device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous operation is unresolved. Use the recovery banner at the top of SideStore to resume its status check or reconcile after checking the device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה קודמת עדיין לא הוכרעה. יש להשתמש בבאנר השחזור בראש SideStore כדי לחדש את בדיקת מצבה או להתאים את המצב השמור לאחר בדיקת המכשיר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次操作的结果尚未确定。请使用 SideStore 顶部的恢复横幅继续检查状态，或在检查设备后核对状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次操作的結果尚未確定。請使用 SideStore 頂部的恢復橫幅繼續檢查狀態，或在檢查裝置後核對狀態。"
          }
        }
      }
    },
    "A previous refresh may still be running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous refresh may still be running"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שרענון קודם עדיין פועל"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次刷新可能仍在进行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次重新整理可能仍在進行"
          }
        }
      }
    },
    "A previous request has an unresolved result. Inspect it in the recovery banner before repeating the action.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous request has an unresolved result. Inspect it in the recovery banner before repeating the action."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאה של בקשה קודמת עדיין לא הוכרעה. יש לבדוק אותה בבאנר השחזור לפני חזרה על הפעולה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次请求的结果尚未确定。请先在恢复横幅中查看，再重复此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次請求的結果尚未確定。請先在恢復橫幅中查看，再重複此操作。"
