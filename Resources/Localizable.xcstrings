        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום המארח אינו בספרייה של SideStore. יש לבדוק את 'חשבון וחתימה'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
